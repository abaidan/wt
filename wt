#!/usr/bin/env bash
#
# wt - git worktree helper with GitHub and Jira integration and iTerm2 automation
#
# Creates a git worktree (optionally named after a GitHub issue or Jira ticket,
# or on a pull request's branch), stores it in a centralized folder, and opens
# it in a new iTerm2 tab with `claude` running.
#
# Usage:
#   wt                        The picker: issues, pull requests, Jira tickets and
#                             worktrees, a tab each
#   wt new                    Pick an open GitHub issue from a list, then branch from it
#   wt new --mine             Same, narrowed to issues assigned to you
#   wt new <issue-number>     Create a worktree/branch named after GitHub issue #<n>
#   wt new --pr [--mine]      Pick an open pull request (--mine: ones you opened)
#                             and check out its branch
#   wt new --pr <number>      Check out pull request #<n>'s branch
#   wt new --jira [--mine]    Pick an open Jira ticket (--mine: assigned to you)
#   wt new <TICKET-KEY>       Create a worktree/branch named after a Jira ticket
#   wt new <url>              Same as the above, from a GitHub issue or pull
#                             request URL, or a Jira /browse/ URL
#   wt new <branch-name>      Create a worktree/branch with an explicit name
#   wt list                   Pick a worktree and switch to its iTerm2 tab, or
#                             open one if it has none
#   wt list --plain           Print the plain `git worktree list` output
#   wt open [branch]          Same as `wt list`; with a branch, opens it directly
#   wt rm [branch]            Remove a worktree; with no argument, pick from a list
#   wt --version              Print the installed version
#
# Env vars:
#   WT_ROOT          Where worktrees are stored (default: ~/worktrees)
#   WT_BASE_BRANCH   Base branch to branch from (default: repo's default branch)
#   WT_NO_CLAUDE     If set to "1", don't auto-run `claude` in the new tab
#   WT_CLAUDE_ARGS   Args passed to claude (default: --permission-mode auto;
#                    set to empty to launch plain `claude`)
#   WT_ISSUE_LIMIT   Most open issues, pull requests or tickets a picker
#                    fetches (default: 1000)
#   WT_PROMPT_TEMPLATE
#                    Prompt typed into claude (left unsent) in a newly created
#                    worktree for a GitHub issue; "{url}" is replaced with the
#                    issue URL. Set empty to disable.
#   WT_PR_PROMPT_TEMPLATE
#                    The same, for a pull request's worktree
#   WT_JIRA_PROMPT_TEMPLATE
#                    The same, for a Jira ticket's worktree
#   WT_PREFILL_DELAY Seconds to wait for claude to start before typing the
#                    prompt (default: 6)
#   WT_NO_PULL       If set to "1", only fetch on `wt new`; don't fast-forward
#                    the local base branch
#   WT_NO_PR         If set to "1", don't look up pull requests at all
#   NO_COLOR         If set, don't colour the pickers
#   WT_KEEP_TABS     If set to "1", don't close the iTerm2 tabs of a removed
#                    worktree
#   WT_NO_TAB_TITLE  If set to "1", don't put the pull request number in the
#                    tab title of a claude that `wt` starts
#   WT_NEW_TAB       If set to "1", always open a new tab when reopening a
#                    worktree, even if one is already open in it
#   WT_JIRA_URL      Jira Cloud site, e.g. https://example.atlassian.net;
#                    setting it is what turns the Jira support on
#   WT_JIRA_EMAIL    Atlassian account email (default: the global, not the
#                    repo's, git config user.email)
#   WT_JIRA_TOKEN    Atlassian API token (default: read from the login
#                    keychain, service "wt-jira", account WT_JIRA_EMAIL)
#   WT_JIRA_PROJECT  Project key the Jira picker lists tickets from
#   WT_JIRA_JQL      JQL for the Jira picker, replacing the default query
#
# Requirements: git, iTerm2 (macOS), and optionally `gh` (for issues and pull
# requests), `curl` and `jq` (for Jira), and `fzf` (for arrow-key pickers;
# falls back to a numbered menu without it).

set -euo pipefail

# Replaced by `./Build` at install time with `git describe` of the checkout it
# was installed from, so a copy on the PATH can say which release it is. Run
# straight from the repo, it stays "dev".
WT_VERSION="dev"

WT_ROOT="${WT_ROOT:-$HOME/worktrees}"

# New tabs start Claude Code in auto mode. Set WT_CLAUDE_ARGS="" for a plain
# `claude`, or WT_NO_CLAUDE=1 to skip launching it at all.
: "${WT_CLAUDE_ARGS=--permission-mode auto}"

# Seeded as claude's first prompt in a worktree created for a GitHub issue
# (and likewise, below, for a pull request or a Jira ticket). "{url}" is
# replaced with that item's URL. Assigned the long way round because a "}"
# inside ${var=default} would end the expansion early.
if [[ -z "${WT_PROMPT_TEMPLATE+set}" ]]; then
  WT_PROMPT_TEMPLATE='Work on this GitHub issue: {url}'
fi
if [[ -z "${WT_PR_PROMPT_TEMPLATE+set}" ]]; then
  WT_PR_PROMPT_TEMPLATE='Work on this pull request: {url}'
fi
if [[ -z "${WT_JIRA_PROMPT_TEMPLATE+set}" ]]; then
  WT_JIRA_PROMPT_TEMPLATE='Work on this Jira ticket: {url}'
fi

# This script's own path, so that the fzf preview can call back into it. A
# bare name is left alone for the preview shell to find on PATH; a relative
# one is anchored now, while the current directory is still known.
WT_SELF="$0"
if [[ "$WT_SELF" != /* && "$WT_SELF" == */* ]]; then
  WT_SELF="$PWD/$WT_SELF"
fi

die() { echo "Error: $*" >&2; exit 1; }

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"
}

repo_name() {
  basename "$(repo_root)"
}

default_branch() {
  local root="$1"
  git -C "$root" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null \
    | sed 's@^refs/remotes/origin/@@' \
    || echo main
}

slugify() {
  echo "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g' \
    | cut -c1-50
}

# Escape a string for use inside an AppleScript double-quoted literal.
applescript_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

# Open $1 (a directory) in a new iTerm2 tab and run $2 (a shell command) there.
# $3, if given, is typed into the running program afterwards WITHOUT a newline,
# so it sits in the prompt box until the user presses enter themselves.
open_iterm_tab() {
  local dir="$1"
  local cmd="${2:-}"
  local prefill="${3:-}"
  local full_cmd; full_cmd="cd $(printf '%q' "$dir")"
  if [[ -n "$cmd" ]]; then
    full_cmd="$full_cmd && $cmd"
  fi
  full_cmd=$(applescript_escape "$full_cmd")

  # Typed only after a pause, since claude needs a moment to draw its prompt
  # box and anything sent before that is dropped.
  local prefill_script=""
  if [[ -n "$prefill" ]]; then
    local delay="${WT_PREFILL_DELAY:-6}"
    [[ "$delay" =~ ^[0-9]+([.][0-9]+)?$ ]] \
      || die "WT_PREFILL_DELAY must be a number of seconds, not '$delay'"
    prefill_script="    delay $delay
    write text \"$(applescript_escape "$prefill")\" newline no"
  fi

  # The session is tagged with the worktree it was opened for, in a user
  # variable that stays with it whatever runs there later. iterm_session_table
  # reads the tag back, so this tab is found by name instead of by asking the
  # kernel where its processes are.
  #
  # The new session is captured before anything is written to it. Addressing
  # "current session of current window" instead would re-resolve on every
  # command, so the prefill typed after the delay would land in whatever tab
  # the user had switched to by then.
  osascript <<APPLESCRIPT
tell application "iTerm2"
  activate
  if (count of windows) = 0 then
    set theWindow to (create window with default profile)
  else
    set theWindow to current window
    tell theWindow to create tab with default profile
  end if
  set theSession to current session of theWindow
  tell theSession
    set variable named "user.wt_worktree" to "$(applescript_escape "$dir")"
    write text "$full_cmd"
$prefill_script
  end tell
end tell
APPLESCRIPT
}

have_fzf() { command -v fzf >/dev/null 2>&1; }

# True when anything running on terminal $1 is sitting in $2, or below it.
# Asked of the kernel rather than of iTerm2, whose own "session.path" only
# refreshes when the shell draws a prompt: a tab that has been running
# `claude` since `wt` opened it still reports whatever directory it was in
# before, which is exactly the tab that needs finding.
tty_is_in() {
  local tty="${1#/dev/}" dir="$2"

  # lsof lives in /usr/sbin, which a login shell has on its PATH and a leaner
  # environment may not; without it, no tab is ever matched and nothing is
  # closed, which is the right way for this to fail.
  local lsof_bin="lsof"
  command -v lsof >/dev/null 2>&1 || lsof_bin=/usr/sbin/lsof
  [[ -x "$lsof_bin" ]] || command -v "$lsof_bin" >/dev/null 2>&1 || return 1

  local pids
  pids=$(ps -t "$tty" -o pid= 2>/dev/null | tr -d ' ' | tr '\n' ',' | sed 's/,$//') \
    || true
  [[ -n "$pids" ]] || return 1

  # lsof exits non-zero over a process that ended between the two calls, with
  # the other answers still on stdout, so its status is deliberately ignored.
  { "$lsof_bin" -a -d cwd -Fn -p "$pids" 2>/dev/null || true; } \
    | awk -v d="$dir" '
        /^n/ { p = substr($0, 2); if (p == d || index(p, d "/") == 1) { hit = 1 } }
        END  { exit !hit }
      '
}

# iTerm2's own command-line client, which ships inside the app from 3.7 on
# and is put on the PATH by its shell integration.
it2_bin() {
  if command -v it2 >/dev/null 2>&1; then
    command -v it2
    return 0
  fi
  local b=/Applications/iTerm.app/Contents/Resources/utilities/it2
  [[ -x "$b" ]] || return 1
  echo "$b"
}

# Fields of iterm_session_table, split on the ASCII unit separator: a tab or a
# space is whitespace to `read`, which runs empty fields together.
WT_FS=$'\x1f'

# One line per iTerm2 session, asked of `it2` in a single call:
# "id<US>tty<US>path<US>tag<US>status", where tag is the worktree `wt` opened
# the tab for (see open_iterm_tab) and status is what iTerm2's Claude Code
# integration last reported - waiting, working, idle and so on - or empty.
# path is the directory the shell last reported; it goes stale while a
# program such as claude runs, which is what the tag is for.
#
# Fails when there is nothing to ask: iTerm2 not running (checked first, so
# this never launches it), no it2 (iTerm2 before 3.7), or its API turned off.
# The perl alarm keeps a stuck API call from hanging `wt`.
iterm_session_table() {
  pgrep -xq iTerm2 2>/dev/null || return 1
  local it2; it2=$(it2_bin) || return 1
  local f="$WT_FS"
  perl -e 'alarm shift; exec @ARGV or exit 1' 5 \
    "$it2" session list --format "\\(id)$f\\(tty)$f\\(path)$f\\(user.wt_worktree)$f\\(status)" \
    2>/dev/null
}

# Print "id<TAB>status" for every iTerm2 session sitting in $1, or below it.
# This finds the tab `wt` opened for a worktree, by its tag, as well as any
# the user opened by hand. status is empty when it is not known. Silent when
# iTerm2 is not running - and it is asked whether it is running rather than
# told anything, so this never launches it.
iterm_sessions_in() {
  local dir="$1"

  local table
  if table=$(iterm_session_table) && [[ -n "$table" ]]; then
    local id tty tag status
    while IFS="$WT_FS" read -r id tty _ tag status; do
      [[ -n "$id" ]] || continue
      if [[ "$tag" == "$dir" ]] || { [[ -n "$tty" ]] && tty_is_in "$tty" "$dir"; }; then
        printf '%s\t%s\n' "$id" "$status"
      fi
    done <<< "$table"
    return 0
  fi

  # Without it2, AppleScript can still list the sessions, though not their
  # tags or status.
  local sessions
  sessions=$(osascript 2>/dev/null <<'APPLESCRIPT'
if application "iTerm2" is running then
  tell application "iTerm2"
    set out to ""
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          set out to out & (id of s) & " " & (tty of s) & linefeed
        end repeat
      end repeat
    end repeat
    return out
  end tell
end if
return ""
APPLESCRIPT
  ) || return 0

  local id tty
  while read -r id tty; do
    [[ -n "$id" && -n "$tty" ]] || continue
    if tty_is_in "$tty" "$dir"; then
      echo "$id"
    fi
  done <<< "$sessions"
}

# Close one iTerm2 session by id. Each call rescans rather than closing a list
# of references collected earlier, because closing a session renumbers the
# ones after it and a stale reference would take the wrong tab with it.
close_iterm_session() {
  local session_id="$1"
  osascript <<APPLESCRIPT >/dev/null 2>&1 || true
if application "iTerm2" is running then
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (id of s) is "$(applescript_escape "$session_id")" then
            close s
            return
          end if
        end repeat
      end repeat
    end repeat
  end tell
end if
APPLESCRIPT
}

# Bring one iTerm2 session by id to the front: its window, its tab, then the
# session itself, so a split pane is focused too. Fails when no session has
# that id any more, which leaves the caller free to open a tab after all.
focus_iterm_session() {
  local session_id="$1"
  local found
  found=$(osascript 2>/dev/null <<APPLESCRIPT
if application "iTerm2" is running then
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (id of s) is "$(applescript_escape "$session_id")" then
            select w
            tell t to select
            tell s to select
            activate
            return "1"
          end if
        end repeat
      end repeat
    end repeat
  end tell
end if
return ""
APPLESCRIPT
  ) || return 1
  [[ "$found" == "1" ]]
}

# Focus a tab already sitting in worktree $1, if there is one. The tab `wt`
# itself is running in is passed over: it's already in front, so "switching"
# to it would do nothing, and a new tab is what's wanted from there.
focus_existing_tab() {
  local dir="$1"
  [[ "${WT_NEW_TAB:-0}" != "1" ]] || return 1

  local self="${ITERM_SESSION_ID#*:}"
  local id
  while read -r id _; do
    [[ -n "$id" && "$id" != "$self" ]] || continue
    focus_iterm_session "$id" && return 0
  done < <(iterm_sessions_in "$dir")
  return 1
}

# The command a freshly opened tab should run ("" means: just cd there).
claude_cmd() {
  if [[ "${WT_NO_CLAUDE:-0}" == "1" ]]; then
    echo ""
    return
  fi
  local cmd="claude"
  if [[ -n "$WT_CLAUDE_ARGS" ]]; then
    cmd="$cmd $WT_CLAUDE_ARGS"
  fi
  local settings
  if settings=$(tab_title_settings); then
    cmd="$cmd --settings $(printf '%q' "$settings")"
  fi
  echo "$cmd"
}

# Hooks that put a worktree's pull request number in its iTerm2 tab title,
# written to a settings file passed to `claude --settings` so nothing has to be
# added to the user's own Claude Code configuration. They call back into this
# script (see cmd_tab_title). Prints the file's path, or fails when titles are
# turned off or the file cannot be written.
tab_title_settings() {
  [[ "${WT_NO_TAB_TITLE:-0}" != "1" ]] || return 1

  # The hook runs from wherever claude was started, so a bare "wt" is pinned
  # down to the copy on the PATH now.
  local self="$WT_SELF"
  if [[ "$self" != /* ]]; then
    self=$(command -v "$self" 2>/dev/null) || return 1
  fi

  local dir="${XDG_STATE_HOME:-$HOME/.local/state}/wt"
  local file="$dir/claude-tab-title.json"
  mkdir -p "$dir" 2>/dev/null || return 1

  local hook; hook=$(json_escape "$(printf '%q' "$self") __tab-title")
  cat > "$file" 2>/dev/null <<EOF || return 1
{
  "hooks": {
    "PostToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "$hook created" }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "$hook idle" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "$hook idle" }] }
    ]
  }
}
EOF
  echo "$file"
}

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

# The terminal the hook's claude is drawing on. Hooks get a pipe for stdin and
# stdout, but they are still in claude's process tree, and the first ancestor
# with a controlling terminal is the tab.
hook_tty() {
  local pid=$$ tty
  while [[ -n "$pid" && "$pid" != 0 && "$pid" != 1 ]]; do
    tty=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ') || return 1
    if [[ -n "$tty" && "$tty" != "??" ]]; then
      echo "/dev/$tty"
      return 0
    fi
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ') || return 1
  done
  return 1
}

# `wt __tab-title created|idle`, run by the hooks from tab_title_settings with
# the hook's JSON on stdin.
#
# Claude Code sets the tab title itself (its topic, and a spinner while it
# works), and iTerm2 has no way to pin a title against that - the last escape
# sequence wins. So the PR title is re-asserted whenever claude goes idle, a
# moment after it has drawn its own: it shows between turns and gives way to
# the spinner during one.
#
# The number is kept in the worktree's own git directory, which goes when the
# worktree does. A `gh pr create` looks it up straight away; otherwise it is
# asked of GitHub at most every ten minutes, which also catches a PR opened
# from the web, or one that existed before the tab did. Everything slow runs
# detached, so claude never waits on the network for a title.
cmd_tab_title() {
  local event="${1:-idle}"
  local payload; payload=$(cat)

  local gitdir; gitdir=$(git rev-parse --absolute-git-dir 2>/dev/null) || return 0
  local tty; tty=$(hook_tty) || return 0
  [[ -w "$tty" ]] || return 0

  local cache="$gitdir/wt-pr" checked="$gitdir/wt-pr-checked"
  local pr=""
  if [[ -f "$cache" ]]; then
    pr=$(cat "$cache" 2>/dev/null || true)
  fi

  local lookup=0
  if [[ "$event" == "created" ]]; then
    [[ "$payload" == *"gh pr create"* ]] || return 0
    lookup=1
  elif [[ -z "$pr" && "${WT_NO_PR:-0}" != "1" ]] \
       && [[ -z "$(find "$checked" -mmin -10 2>/dev/null)" ]]; then
    lookup=1
  fi
  if (( lookup )) && ! command -v gh >/dev/null 2>&1; then
    lookup=0
  fi
  # With nothing cached and nothing to look up, there is still one case worth
  # waiting for: a `gh pr create` at the very end of this turn, whose lookup
  # may not have finished by the time claude goes idle.
  local wait_for_cache=0
  if [[ -z "$pr" && "$lookup" == 0 ]]; then
    [[ "$event" == "idle" && -n "$(find "$checked" -mmin -1 2>/dev/null)" ]] || return 0
    wait_for_cache=1
  fi

  (
    if (( lookup )); then
      touch "$checked" 2>/dev/null || true
      found=$(gh pr view --json number -q .number 2>/dev/null || true)
      if [[ "$found" =~ ^[0-9]+$ ]]; then
        pr="$found"
        printf '%s\n' "$pr" > "$cache" 2>/dev/null || true
      fi
    fi
    [[ "$event" == "idle" ]] || exit 0
    sleep 1
    tries=0
    while (( wait_for_cache && tries < 8 )) && [[ -z "$pr" ]]; do
      pr=$(cat "$cache" 2>/dev/null || true)
      [[ -n "$pr" ]] || sleep 1
      tries=$((tries + 1))
    done
    if [[ -n "$pr" ]]; then
      printf '\033]1;PR #%s\007' "$pr" > "$tty" 2>/dev/null || true
    fi
  ) </dev/null >/dev/null 2>&1 &
  return 0
}

# Open a worktree in a new tab. For a worktree created just now, pass the
# prompt template ($2) and the URL of the issue, pull request or ticket it is
# for ($3): its claude gets the prompt typed into the prompt box, left unsent.
# Reopening an existing worktree never prefills, because that session has its
# own history and the link would only be in the way - and if a tab is already
# sitting in it, that tab is brought forward instead of opening another.
open_worktree() {
  local wt_path="$1" template="${2:-}" url="${3:-}"

  if [[ -z "$url" ]] && focus_existing_tab "$wt_path"; then
    echo "Switched to the tab already open in it"
    return
  fi

  local prompt=""
  if [[ -n "$url" && -n "$template" && "${WT_NO_CLAUDE:-0}" != "1" ]]; then
    prompt="${template//\{url\}/$url}"
    echo "Prefilling claude's prompt (press enter to send it):"
    echo "  $prompt"
  fi

  open_iterm_tab "$wt_path" "$(claude_cmd)" "$prompt"
}

require_gh() {
  command -v gh >/dev/null 2>&1 || die "gh CLI not found. Install with 'brew install gh' and run 'gh auth login', or pass a branch name instead."
}

# The repo's "owner/name" on GitHub, for picker headers; the directory name
# when gh cannot say.
github_label() {
  local root="$1"
  (cd "$root" && gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null) \
    || repo_name
}

# Offer the menu lines "<id><TAB><display>" in $1 and print the id of the
# one picked - or, in the numbered fallback, whatever was typed, which the
# caller validates. Prints nothing at all if the user cancels. $2 heads the
# list, $3 names what is listed ("issues"), $4 is fzf's prompt and $5 its
# preview command, where {1} is the id. The menu goes to stderr so stdout
# carries only the answer.
pick_from_menu() {
  local menu="$1" label="$2" what="$3" prompt="$4" preview="$5"
  local count; count=$(printf '%s' "$menu" | grep -c '')

  local reply
  if have_fzf; then
    local sel
    sel=$(printf '%s' "$menu" | fzf \
      --delimiter=$'\t' --with-nth=2.. --ansi \
      --height=90% --border --reverse --no-multi \
      --prompt="$prompt" \
      --header="$label: $count open   (type to filter, enter to pick, esc to cancel)" \
      --preview="$preview" \
      --preview-window='right:48%:wrap') || return 0
    reply=$(printf '%s' "$sel" | cut -f1)
  else
    echo >&2
    # Without fzf there is no filtering, so print only the newest ones rather
    # than scroll hundreds of lines past; anything can still be typed.
    local max_shown=50
    echo "Open $what in $label:" >&2
    printf '%s' "$menu" | head -n "$max_shown" | cut -f2- | sed 's/^/  /' >&2
    if (( count > max_shown )); then
      echo "  ... and $(( count - max_shown )) more (install fzf to search them all)" >&2
    fi
    echo >&2
    read -r -p "Which one? (blank to cancel): " reply || reply=""
  fi
  printf '%s' "${reply//[[:space:]]/}"
}

# Print the title of $1 from menu lines "<id><TAB><display>" plus a parallel
# "<id><TAB><title><TAB><url>" list in $2, as "<title><TAB><url>"; nothing for
# an id that was typed rather than listed.
menu_details() {
  printf '%s\n' "$2" | awk -F'\t' -v id="$1" '$1 == id { print $2 "\t" $3; exit }'
}

# Let the user pick one of the repo's open GitHub issues, and print it as
# "<number><TAB><title><TAB><url>" - the title and URL empty for a number
# typed into the fallback menu that was not in the list. Prints nothing if
# the user cancels.
# The open issues, as "<number><TAB><title><TAB><url>" lines. The limit is
# high enough to take in every open issue on most repos, so that typing in fzf
# searches all of them rather than only the newest page; gh pages through the
# API 100 at a time to get there.
fetch_issues() {
  local root="$1" only_mine="$2"
  local -a gh_args=(issue list --state open --limit "${WT_ISSUE_LIMIT:-1000}")
  if [[ "$only_mine" == "1" ]]; then
    gh_args[${#gh_args[@]}]="--assignee"
    gh_args[${#gh_args[@]}]="@me"
  fi
  (cd "$root" && gh "${gh_args[@]}" --json number,title,url \
     --jq '.[] | [.number, .title, .url] | @tsv')
}

# The open pull requests, as "<number><TAB><head branch><TAB><title>" lines.
fetch_prs() {
  local root="$1" only_mine="$2"
  local -a gh_args=(pr list --state open --limit "${WT_ISSUE_LIMIT:-1000}")
  if [[ "$only_mine" == "1" ]]; then
    gh_args[${#gh_args[@]}]="--author"
    gh_args[${#gh_args[@]}]="@me"
  fi
  (cd "$root" && gh "${gh_args[@]}" --json number,title,headRefName,isDraft \
     --jq '.[] | [.number, .headRefName, (if .isDraft then "[draft] " else "" end) + .title] | @tsv')
}

# "<name><TAB><path>" for the branch and the directory name of every linked
# worktree, as a string wrapped in newlines for map_get to search.
worktree_name_map() {
  local m
  m=$(list_worktrees "$1" 0 | awk -F'\t' '{ n = split($1, d, "/"); print $2 "\t" $1; print d[n] "\t" $1 }')
  printf '\n%s\n' "$m"
}

# Look $2 up in a map from worktree_name_map (or one shaped like it), leaving
# the path in MAP_VAL. Pure bash, so a list of hundreds of issues does not pay
# for a process per line.
MAP_VAL=""
map_get() {
  local map="$1" key="$2"
  local rest="${map#*$'\n'"$key"$'\t'}"
  [[ "$rest" != "$map" ]] || return 1
  MAP_VAL="${rest%%$'\n'*}"
}

# The mark an issue, pull request or ticket carries when worktree $1 is its:
# "[worktree]", or what the iTerm2 tab in it is doing, ten columns wide.
item_mark() {
  case "$(tab_state "$1")" in
    4) paint 35 "[waiting] " ;;
    3) paint 31 "[error]   " ;;
    2) paint 34 "[working] " ;;
    1) paint 90 "[tab open]" ;;
    *) paint 36 "[worktree]" ;;
  esac
}

# Menu lines "<id><TAB><display>" for the raw lines of fetch_issues ($2).
#
# The mark sits between the number and the title, never after the title: fzf
# gives the list only about half the width next to the preview, so anything
# past a padded title is cut off the edge of the screen in most terminals.
#
# An issue has a worktree by the same rule as find_worktree_for_issue: a
# branch or directory named "<n>" or "<n>-anything", so a branch named after
# an issue whose title slugs to nothing still counts.
issue_rows() {
  local root="$1" raw="$2"
  [[ -n "$WT_SESSION_TABLE" ]] || WT_SESSION_TABLE=$(iterm_session_table || true)
  local map
  map=$'\n'$(worktree_name_map "$root" \
    | awk -F'\t' 'match($1, /^[0-9]+(-|$)/) { k = $1; sub(/-.*/, "", k); print k "\t" $2 }')$'\n'
  local n title url mark
  while IFS=$'\t' read -r n title url; do
    [[ -n "$n" ]] || continue
    mark="          "
    if map_get "$map" "$n"; then
      mark=$(item_mark "$MAP_VAL")
    fi
    (( ${#title} <= 64 )) || title="${title:0:61}..."
    printf '%s\t#%-6s %s  %s\n' "$n" "$n" "$mark" "$title"
  done <<< "$raw"
}

# Menu lines for the raw lines of fetch_prs ($2). A pull request has a
# worktree when its branch is checked out, or a worktree directory carries the
# branch's name, as new_pr_worktree names it - with "pr-<n>-" in front for one
# from a fork.
pr_rows() {
  local root="$1" raw="$2"
  [[ -n "$WT_SESSION_TABLE" ]] || WT_SESSION_TABLE=$(iterm_session_table || true)
  local map; map=$(worktree_name_map "$root")
  local n head title mark dir
  while IFS=$'\t' read -r n head title; do
    [[ -n "$n" ]] || continue
    mark="          "
    dir="${head//\//-}"
    if map_get "$map" "$head" || map_get "$map" "$dir" || map_get "$map" "pr-$n-$dir"; then
      mark=$(item_mark "$MAP_VAL")
    fi
    (( ${#title} <= 64 )) || title="${title:0:61}..."
    printf '%s\t#%-6s %s  %s\n' "$n" "$n" "$mark" "$title"
  done <<< "$raw"
}

# Menu lines for Jira's "<KEY><TAB><summary>" lines ($2). Same rule as for
# issues: a ticket has a worktree when a branch or directory is "<KEY>" or
# "<KEY>-anything".
jira_rows() {
  local root="$1" raw="$2"
  [[ -n "$WT_SESSION_TABLE" ]] || WT_SESSION_TABLE=$(iterm_session_table || true)
  local map
  map=$'\n'$(worktree_name_map "$root" \
    | awk -F'\t' 'match($1, /^[A-Z][A-Z0-9_]+-[0-9]+(-|$)/) { k = substr($1, 1, RLENGTH); sub(/-$/, "", k); print k "\t" $2 }')$'\n'
  local key title mark
  while IFS=$'\t' read -r key title; do
    [[ -n "$key" ]] || continue
    mark="          "
    if map_get "$map" "$key"; then
      mark=$(item_mark "$MAP_VAL")
    fi
    (( ${#title} <= 64 )) || title="${title:0:61}..."
    printf '%s\t%-11s %s  %s\n' "$key" "$key" "$mark" "$title"
  done <<< "$raw"
}

pick_issue() {
  local root="$1" only_mine="$2"
  require_gh

  echo "Fetching open issues..." >&2
  local raw
  raw=$(fetch_issues "$root" "$only_mine" 2>&1) \
    || die "could not list issues via gh: $raw"

  if [[ -z "$raw" ]]; then
    if [[ "$only_mine" == "1" ]]; then
      die "no open issues assigned to you (drop --mine to see all)"
    fi
    die "no open issues found for this repo"
  fi

  local menu; menu=$(issue_rows "$root" "$raw")

  local reply
  reply=$(pick_from_menu "$menu" "$(github_label "$root")" issues 'issue > ' \
            "cd $(printf '%q' "$root") && gh issue view {1}")
  [[ -n "$reply" ]] || return 0
  reply="${reply#\#}"
  [[ "$reply" =~ ^[0-9]+$ ]] || die "not an issue number: '$reply'"
  printf '%s\t%s\n' "$reply" "$(menu_details "$reply" "$raw")"
}

# Let the user pick one of the repo's open pull requests, and print its
# number; nothing if the user cancels. With $2 = "1", only the ones you opened.
pick_pr() {
  local root="$1" only_mine="$2"
  require_gh

  echo "Fetching open pull requests..." >&2
  local raw
  raw=$(fetch_prs "$root" "$only_mine" 2>&1) \
    || die "could not list pull requests via gh: $raw"

  if [[ -z "$raw" ]]; then
    if [[ "$only_mine" == "1" ]]; then
      die "no open pull requests of yours (drop --mine to see all)"
    fi
    die "no open pull requests found for this repo"
  fi

  local menu; menu=$(pr_rows "$root" "$raw")

  local reply
  reply=$(pick_from_menu "$menu" "$(github_label "$root")" "pull requests" 'pr > ' \
            "cd $(printf '%q' "$root") && GH_FORCE_TTY=\${FZF_PREVIEW_COLUMNS:-80} gh pr view {1}")
  [[ -n "$reply" ]] || return 0
  reply="${reply#\#}"
  [[ "$reply" =~ ^[0-9]+$ ]] || die "not a pull request number: '$reply'"
  echo "$reply"
}

# --- Jira -------------------------------------------------------------------

# A Jira ticket key, e.g. SRE-1234.
JIRA_KEY_RE='^[A-Z][A-Z0-9_]+-[0-9]+$'

jira_enabled() { [[ -n "${WT_JIRA_URL:-}" ]]; }

require_jira() {
  jira_enabled \
    || die "Jira is not set up: set WT_JIRA_URL to your site, e.g. https://example.atlassian.net (see 'wt help')"
  command -v jq >/dev/null 2>&1 || die "jq not found; Jira support needs it ('brew install jq')"
}

# The account Jira requests are made as. Its fallback is the global git email,
# not the repo's: a repo that commits under a personal address must not
# change which Jira account `wt` signs in as.
jira_email() {
  local email="${WT_JIRA_EMAIL:-}"
  [[ -n "$email" ]] || email=$(git config --global user.email 2>/dev/null || true)
  printf '%s' "$email"
}

# The API token, from WT_JIRA_TOKEN or else the login keychain - so that it
# need not sit in a shell profile in plain text.
jira_token() {
  if [[ -n "${WT_JIRA_TOKEN:-}" ]]; then
    printf '%s' "$WT_JIRA_TOKEN"
    return
  fi
  security find-generic-password -s wt-jira -a "$(jira_email)" -w 2>/dev/null
}

# Call the Jira Cloud REST API and print the response: $1 = method, $2 = path
# on the site, $3 = an optional JSON body. Dies with Jira's own explanation
# when the request fails. The credentials reach curl through a config file on
# a pipe rather than its command line, where any process listing shows them.
jira_api() {
  local method="$1" path="$2" body="${3:-}"
  local email token
  email=$(jira_email)
  [[ -n "$email" ]] || die "no Jira account: set WT_JIRA_EMAIL"
  token=$(jira_token) || token=""
  [[ -n "$token" ]] || die "no Jira API token for $email. Create one at
  https://id.atlassian.com/manage-profile/security/api-tokens
copy it, and store it from the clipboard with:
  security add-generic-password -U -s wt-jira -a '$email' -w \"\$(pbpaste)\"
or set WT_JIRA_TOKEN."

  local creds="$email:$token"
  creds="${creds//\\/\\\\}"
  creds="${creds//\"/\\\"}"

  local -a args=(-sS -X "$method" -H 'Accept: application/json' -w '\n%{http_code}')
  if [[ -n "$body" ]]; then
    args[${#args[@]}]="-H"
    args[${#args[@]}]="Content-Type: application/json"
    args[${#args[@]}]="--data-binary"
    args[${#args[@]}]="$body"
  fi

  local resp
  resp=$(curl "${args[@]}" -K <(printf 'user = "%s"\n' "$creds") \
           "${WT_JIRA_URL%/}$path") \
    || die "could not reach Jira at $WT_JIRA_URL"

  local code="${resp##*$'\n'}"
  resp="${resp%$'\n'*}"
  if [[ "$code" != 2* ]]; then
    if [[ "$code" == 401 ]]; then
      # The keychain's own prompt reads at most 128 characters, and a token
      # typed or pasted into it is cut short without a word.
      if (( ${#token} == 128 )); then
        die "Jira rejected the credentials for $email (HTTP 401). The token is exactly 128 characters - cut short by the 'security ... -w' prompt, which reads no more. Copy the token and store it from the clipboard instead:
  security add-generic-password -U -s wt-jira -a '$email' -w \"\$(pbpaste)\""
      fi
      die "Jira rejected the credentials for $email (HTTP 401); check WT_JIRA_EMAIL and the API token (an API token, not a password: about 190 characters, starting ATATT)"
    fi
    local msg
    msg=$(printf '%s' "$resp" \
            | jq -r '[.errorMessages[]?, ((.errors // {}) | .[])] | join("; ")' 2>/dev/null) \
      || msg=""
    die "Jira request failed (HTTP $code)${msg:+: $msg}"
  fi
  printf '%s' "$resp"
}

# Make sure Jira accepts the credentials before relying on them. Rejected
# ones only fail loudly where an account is required: a search instead runs
# as an anonymous visitor and comes back empty, and a ticket lookup says the
# ticket does not exist - either of which sends you looking in the wrong place.
jira_check_login() {
  jira_api GET /rest/api/3/myself >/dev/null || exit 1
}

# The JQL behind the Jira picker: WT_JIRA_JQL, or the open tickets of
# WT_JIRA_PROJECT - narrowed to your own with $1 = "1". With neither set it is
# your own open tickets, since every open ticket on a site is no use to pick
# from.
jira_picker_jql() {
  local only_mine="$1" jql="${WT_JIRA_JQL:-}"
  if [[ -z "$jql" ]]; then
    jql="statusCategory != Done"
    if [[ -n "${WT_JIRA_PROJECT:-}" ]]; then
      jql="project = \"$WT_JIRA_PROJECT\" AND $jql"
    else
      only_mine=1
    fi
  fi
  [[ "$only_mine" != "1" ]] || jql="assignee = currentUser() AND ($jql)"
  printf '%s ORDER BY updated DESC' "$jql"
}

# Print "<key><TAB><summary>" for every ticket $1 (JQL) matches, up to
# WT_ISSUE_LIMIT. The search API pages by token, 100 at a time.
jira_search() {
  local jql="$1" limit="${WT_ISSUE_LIMIT:-1000}" next="" body page got=0
  while :; do
    body=$(jq -nc --arg jql "$jql" --arg next "$next" \
             '{jql: $jql, fields: ["summary"], maxResults: 100}
              + (if $next == "" then {} else {nextPageToken: $next} end)')
    page=$(jira_api POST /rest/api/3/search/jql "$body") || exit 1
    printf '%s' "$page" | jq -r '.issues[] | [.key, .fields.summary] | @tsv'
    got=$(( got + $(printf '%s' "$page" | jq '.issues | length') ))
    next=$(printf '%s' "$page" | jq -r '.nextPageToken // empty')
    if [[ -z "$next" ]] || (( got >= limit )); then
      break
    fi
  done
}

# The summary of Jira ticket $1.
jira_summary() {
  local resp
  resp=$(jira_api GET "/rest/api/3/issue/$1?fields=summary") || exit 1
  printf '%s' "$resp" | jq -r .fields.summary
}

# Let the user pick an open Jira ticket, and print it as "<key><TAB><summary>",
# the summary empty for a key typed into the fallback menu that was not in the
# list. Prints nothing if the user cancels.
pick_jira_ticket() {
  local root="$1" only_mine="$2"
  require_jira

  echo "Fetching open Jira tickets..." >&2
  local raw
  raw=$(jira_search "$(jira_picker_jql "$only_mine")") || exit 1
  [[ -n "$raw" ]] || die "no open Jira tickets match: $(jira_picker_jql "$only_mine")"

  local menu; menu=$(jira_rows "$root" "$raw")

  local label="Jira"
  [[ -z "${WT_JIRA_PROJECT:-}" ]] || label="Jira $WT_JIRA_PROJECT"
  local reply
  reply=$(pick_from_menu "$menu" "$label" tickets 'ticket > ' \
            "$(printf '%q' "$WT_SELF") __jira-preview {1}")
  [[ -n "$reply" ]] || return 0
  reply=$(printf '%s' "$reply" | tr '[:lower:]' '[:upper:]')
  [[ "$reply" =~ $JIRA_KEY_RE ]] || die "not a Jira ticket key: '$reply'"
  printf '%s\t%s\n' "$reply" "$(menu_details "$reply" "$raw" | cut -f1)"
}

# `wt __jira-preview <key>`, the Jira picker's preview pane. API version 2,
# because it returns the description as text rather than a document tree.
cmd_jira_preview() {
  local key="${1:-}"
  [[ "$key" =~ $JIRA_KEY_RE ]] || return 0
  require_jira
  local resp
  resp=$(jira_api GET "/rest/api/2/issue/$key?fields=summary,status,issuetype,priority,assignee,reporter,description") \
    || return 0
  printf '%s' "$resp" | jq -r '
    .fields as $f
    | "\(.key)  \($f.issuetype.name // "")\n\($f.summary)\n",
      "Status:    \($f.status.name // "-")",
      "Assignee:  \($f.assignee.displayName // "unassigned")",
      "Reporter:  \($f.reporter.displayName // "-")",
      "Priority:  \($f.priority.name // "-")\n",
      ($f.description // "(no description)")'
}

# Fetch the base branch and fast-forward the local copy of it to match.
#
# The worktree itself is always created from origin/<base>, so this is not for
# the new branch - it is for the checkout the user came from. Without it that
# tree's `main` drifts further behind on every `wt new`, and the next build,
# test run or diff there is against a stale base.
#
# Never anything but a fast-forward: local commits on the base branch, or a
# working tree that would be clobbered, leave it exactly as it was with a note.
sync_base_branch() {
  local root="$1" base="$2"

  echo "Fetching latest '$base'..."
  git -C "$root" fetch origin "$base" --quiet 2>/dev/null \
    || { echo "  (fetch failed - using what is already here)"; return 0; }

  [[ "${WT_NO_PULL:-0}" != "1" ]] || return 0
  git -C "$root" show-ref --verify --quiet "refs/remotes/origin/$base" || return 0
  git -C "$root" show-ref --verify --quiet "refs/heads/$base" || return 0

  local local_sha remote_sha
  local_sha=$(git -C "$root" rev-parse "refs/heads/$base")
  remote_sha=$(git -C "$root" rev-parse "refs/remotes/origin/$base")
  [[ "$local_sha" != "$remote_sha" ]] || return 0

  if ! git -C "$root" merge-base --is-ancestor "$local_sha" "$remote_sha"; then
    echo "  Local '$base' has commits origin/$base does not; leaving it alone."
    return 0
  fi

  local behind
  behind=$(git -C "$root" rev-list --count "$local_sha..$remote_sha" 2>/dev/null) \
    || behind=""

  # Not checked out anywhere, so there is no working tree to disturb and the
  # ref can simply be moved. The old value is passed too, so a concurrent git
  # that moved it in the meantime makes this fail rather than overwrite.
  local held; held=$(find_worktree_path "$root" "$base")
  if [[ -z "$held" ]]; then
    if git -C "$root" update-ref -m "wt: fast-forward to origin/$base" \
         "refs/heads/$base" "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "  Fast-forwarded '$base' by ${behind:-some} commit(s)."
    fi
    return 0
  fi

  # Checked out somewhere: this has to go through a merge so that the index and
  # the files on disk move with the ref. --ff-only makes git refuse rather than
  # merge or clobber, which is the whole contract here.
  if git -C "$held" merge --ff-only --quiet "origin/$base" 2>/dev/null; then
    echo "  Fast-forwarded '$base' by ${behind:-some} commit(s) in $(short_path "$held")."
  else
    echo "  Could not fast-forward '$base' in $(short_path "$held"); leaving it alone."
  fi
}

# Check out pull request $4's branch in a worktree of its own, or open the one
# it already has. With no number, pick from the open ones ($5 = "1": yours).
#
# The worktree is on the pull request's own branch, so commits there go
# straight into it, and its directory is named after that branch - so a pull
# request opened from a `wt new` worktree comes back to that same worktree.
# One from a fork has no branch here to share; it gets "pr-<n>-<branch>",
# cut from what GitHub keeps of it under refs/pull, without an upstream.
new_pr_worktree() {
  local root="$1" repo="$2" base="$3" num="$4" only_mine="$5"
  require_gh

  if [[ -z "$num" ]]; then
    num=$(pick_pr "$root" "$only_mine") || exit 1
    if [[ -z "$num" ]]; then
      echo "Cancelled."
      return
    fi
  fi

  local info title url head cross state
  info=$(cd "$root" && gh pr view "$num" --json title,url,headRefName,isCrossRepository,state \
           --jq '[.headRefName, .isCrossRepository, .state, .url, .title] | @tsv') \
    || die "could not fetch pull request #$num via gh"
  IFS=$'\t' read -r head cross state url title <<< "$info"
  echo "Pull request #$num: $title"
  if [[ "$state" != "OPEN" ]]; then
    echo "  (it is $(printf '%s' "$state" | tr '[:upper:]' '[:lower:]'))"
  fi

  local branch="$head"
  [[ "$cross" != "true" ]] || branch="pr-$num-$head"
  local wt_path="$WT_ROOT/$repo/${branch//\//-}"

  local live; live=$(find_worktree_path "$root" "$branch")
  if [[ -n "$live" ]]; then
    if [[ -d "$live" ]]; then
      echo "Its branch '$branch' is already checked out at $(short_path "$live"), opening it."
      open_worktree "$live"
      return
    fi
    echo "Clearing stale worktree registration at $live"
    git -C "$root" worktree prune
  fi

  if [[ -d "$wt_path" ]] && worktree_is_registered "$root" "$wt_path"; then
    local on; on=$(list_worktrees "$root" 0 | awk -F'\t' -v p="$wt_path" '$1 == p { print $2; exit }')
    echo "Worktree at $(short_path "$wt_path") already exists (now on '$on'), opening it."
    open_worktree "$wt_path"
    return
  fi
  [[ -e "$wt_path" ]] \
    && die "path already exists and is not a worktree for '$branch': $wt_path"

  mkdir -p "$(dirname "$wt_path")"
  sync_base_branch "$root" "$base"

  echo "Fetching the pull request's branch..."
  local tip
  if [[ "$cross" == "true" ]]; then
    git -C "$root" fetch --quiet origin "refs/pull/$num/head" \
      || die "could not fetch pull request #$num from origin"
    tip=$(git -C "$root" rev-parse FETCH_HEAD)
  else
    git -C "$root" fetch --quiet origin "+refs/heads/$head:refs/remotes/origin/$head" \
      || die "could not fetch '$head' from origin"
    tip=$(git -C "$root" rev-parse "refs/remotes/origin/$head")
  fi

  if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
    # Checked out nowhere (see above), so the ref can simply be moved - but
    # only ever forward: commits of your own on it are left exactly as they are.
    local mine; mine=$(git -C "$root" rev-parse "refs/heads/$branch")
    if [[ "$mine" != "$tip" ]]; then
      if git -C "$root" merge-base --is-ancestor "$mine" "$tip"; then
        git -C "$root" update-ref -m "wt: fast-forward to pull request #$num" \
          "refs/heads/$branch" "$tip" "$mine"
        echo "  Fast-forwarded the local '$branch' to the pull request."
      else
        echo "  Local '$branch' has commits the pull request does not; leaving it alone."
      fi
    fi
    echo "Creating worktree at $wt_path (existing branch: $branch)"
    git -C "$root" worktree add "$wt_path" "$branch"
  elif [[ "$cross" == "true" ]]; then
    echo "Creating worktree at $wt_path (branch: $branch, from a fork)"
    git -C "$root" worktree add -b "$branch" "$wt_path" "$tip"
    echo "  It has no upstream: 'git push' there needs a remote for the fork."
  else
    echo "Creating worktree at $wt_path (branch: $branch)"
    git -C "$root" worktree add --track -b "$branch" "$wt_path" "origin/$head"
  fi

  open_worktree "$wt_path" "$WT_PR_PROMPT_TEMPLATE" "$url"
}

# For a GitHub issue or pull request URL ($1), print "issue <n>" or "pr <n>";
# for a Jira /browse/ URL, "jira <KEY>"; nothing for anything else. A GitHub
# link to some other repo than the one at $2 is refused rather than looked up
# here by number, which would find an unrelated issue of the same number.
parse_item_url() {
  local url="$1" root="$2"
  if [[ "$url" =~ ^https?://[^/]+/browse/([A-Za-z][A-Za-z0-9_]*-[0-9]+) ]]; then
    printf 'jira %s\n' "$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]')"
    return
  fi
  [[ "$url" =~ ^https?://[^/]+/([^/]+/[^/]+)/(issues|pull)/([0-9]+) ]] || return 0
  local slug="${BASH_REMATCH[1]}" kind="${BASH_REMATCH[2]}" num="${BASH_REMATCH[3]}"
  require_gh
  local here; here=$(cd "$root" && gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null) || here=""
  local lower_slug lower_here
  lower_slug=$(printf '%s' "$slug" | tr '[:upper:]' '[:lower:]')
  lower_here=$(printf '%s' "$here" | tr '[:upper:]' '[:lower:]')
  [[ -z "$here" || "$lower_slug" == "$lower_here" ]] \
    || die "that link is to $slug, but this repo is $here"
  if [[ "$kind" == "pull" ]]; then
    printf 'pr %s\n' "$num"
  else
    printf 'issue %s\n' "$num"
  fi
}

cmd_new() {
  local arg="" only_mine=0 source="" a
  for a in "$@"; do
    case "$a" in
      --mine) only_mine=1 ;;
      --pr) source="pr" ;;
      --jira) source="jira" ;;
      -*) die "unknown option '$a' (see 'wt help')" ;;
      *)
        [[ -z "$arg" ]] || die "usage: wt new [--pr|--jira] [--mine] [number|ticket-key|url|branch-name]"
        arg="$a"
        ;;
    esac
  done

  # Nothing named: the picker, opened on the tab for what was asked for.
  if [[ -z "$arg" ]] && have_fzf; then
    case "$source" in
      pr)   cmd_ui prs "$only_mine" ;;
      jira) require_jira; jira_check_login; cmd_ui jira "$only_mine" ;;
      *)    cmd_ui issues "$only_mine" ;;
    esac
    return
  fi

  local root repo base
  root=$(repo_root)
  repo=$(repo_name)
  base="${WT_BASE_BRANCH:-$(default_branch "$root")}"

  # Work out what the argument names. A pasted link says so itself; a bare
  # "ABC-123" is a Jira key only once Jira is set up, since without it the
  # name could as well be a branch.
  if [[ "$arg" == http://* || "$arg" == https://* ]]; then
    local parsed; parsed=$(parse_item_url "$arg" "$root") || exit 1
    [[ -n "$parsed" ]] || die "not a GitHub issue, pull request or Jira ticket link: $arg"
    source="${parsed%% *}"
    arg="${parsed#* }"
  elif [[ "$source" == "jira" && -n "$arg" ]]; then
    arg=$(printf '%s' "$arg" | tr '[:lower:]' '[:upper:]')
    [[ "$arg" =~ $JIRA_KEY_RE ]] || die "not a Jira ticket key: '$arg'"
  elif [[ "$source" == "pr" && -n "$arg" ]]; then
    arg="${arg#\#}"
    [[ "$arg" =~ ^[0-9]+$ ]] || die "not a pull request number: '$arg'"
  elif [[ -z "$source" && "$arg" =~ $JIRA_KEY_RE ]] && jira_enabled; then
    source="jira"
  fi

  if [[ "$source" == "pr" ]]; then
    new_pr_worktree "$root" "$repo" "$base" "$arg" "$only_mine"
    return
  fi

  # An issue or a ticket: its id, its title, and the link claude is seeded
  # with. Anything else is a branch name, and gets none of the three.
  local id="" title="" url="" template="" what="" branch picked
  if [[ "$source" == "jira" ]]; then
    require_jira
    jira_check_login
    if [[ -z "$arg" ]]; then
      picked=$(pick_jira_ticket "$root" "$only_mine") || exit 1
      if [[ -z "$picked" ]]; then
        echo "Cancelled."
        return
      fi
      IFS=$'\t' read -r id title <<< "$picked"
    else
      id="$arg"
    fi
    if [[ -z "$title" ]]; then
      title=$(jira_summary "$id") || exit 1
    fi
    url="${WT_JIRA_URL%/}/browse/$id"
    template="$WT_JIRA_PROMPT_TEMPLATE"
    what="Ticket $id"
  elif [[ -z "$arg" || "$arg" =~ ^#?[0-9]+$ ]]; then
    require_gh
    if [[ -z "$arg" ]]; then
      picked=$(pick_issue "$root" "$only_mine") || exit 1
      if [[ -z "$picked" ]]; then
        echo "Cancelled."
        return
      fi
      IFS=$'\t' read -r id title url <<< "$picked"
    else
      id="${arg#\#}"
    fi
    if [[ -z "$title" ]]; then
      # Not in the list (or no list): look it up, so that an issue past the
      # end of what the picker fetched is still usable.
      local info
      info=$(cd "$root" && gh issue view "$id" --json title,url --jq '[.url, .title] | @tsv') \
        || die "could not fetch issue #$id via gh"
      IFS=$'\t' read -r url title <<< "$info"
    fi
    template="$WT_PROMPT_TEMPLATE"
    what="Issue #$id"
  fi

  if [[ -n "$id" ]]; then
    echo "$what: $title"
    # A Jira key keeps its capitals: that is how Jira recognises it in a
    # branch name, to link the branch to the ticket.
    local slug; slug=$(slugify "$title")
    branch="$id${slug:+-$slug}"
  else
    branch=$(slugify "$arg")
  fi

  local wt_path="$WT_ROOT/$repo/$branch"

  # Already checked out somewhere? Then "new" means "take me back to it".
  local live; live=$(find_worktree_path "$root" "$branch")
  if [[ -n "$live" ]]; then
    if [[ -d "$live" ]]; then
      echo "Worktree for '$branch' already exists, opening it."
      open_worktree "$live"
      return
    fi
    # Registered but the directory is gone. `worktree add` does not prune
    # stale entries itself, so without this it dies with "'$branch' is
    # already used by worktree at <a path that no longer exists>".
    echo "Clearing stale worktree registration at $live"
    git -C "$root" worktree prune
  fi

  # Same issue, older title: the branch name derived just now carries the
  # current slug, so the exact lookup above misses a worktree created before
  # the issue was renamed. The picker already calls that issue checked out, so
  # honour it rather than creating a second worktree for the same issue.
  if [[ -n "$id" ]]; then
    local found found_path found_branch
    found=$(find_worktree_for_issue "$root" "$id")
    if [[ -n "$found" ]]; then
      IFS=$'\t' read -r found_path found_branch <<< "$found"
      if [[ -d "$found_path" ]]; then
        echo "$what is already checked out as '$found_branch', opening it."
        open_worktree "$found_path"
        return
      fi
    fi
  fi

  # The directory is a worktree, but its branch has since been switched to
  # something else: it is still where this issue's work lives, so open it.
  if [[ -d "$wt_path" ]] && worktree_is_registered "$root" "$wt_path"; then
    local on; on=$(list_worktrees "$root" 0 | awk -F'\t' -v p="$wt_path" '$1 == p { print $2; exit }')
    echo "Worktree at $(short_path "$wt_path") already exists (now on '$on'), opening it."
    open_worktree "$wt_path"
    return
  fi

  # A directory in the way that git knows nothing about needs a human.
  [[ -e "$wt_path" ]] \
    && die "path already exists and is not a worktree for '$branch': $wt_path"

  mkdir -p "$(dirname "$wt_path")"

  sync_base_branch "$root" "$base"

  if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
    # Branch left behind by an earlier `wt rm` that kept it: check it out
    # rather than failing on `-b`, which refuses an existing branch.
    echo "Creating worktree at $wt_path (existing branch: $branch)"
    git -C "$root" worktree add "$wt_path" "$branch"
  else
    echo "Creating worktree at $wt_path (branch: $branch, base: $base)"
    if git -C "$root" show-ref --verify --quiet "refs/remotes/origin/$base"; then
      git -C "$root" worktree add -b "$branch" "$wt_path" "origin/$base"
    else
      git -C "$root" worktree add -b "$branch" "$wt_path" "$base"
    fi
  fi

  open_worktree "$wt_path" "$template" "$url"
}

# Pick one worktree (the main working tree included) and open it in a new tab.
pick_worktree_and_open() {
  local root="$1"

  local -a paths=() branches=()
  local path branch
  while IFS=$'\t' read -r path branch; do
    [[ -n "$path" ]] || continue
    paths[${#paths[@]}]="$path"
    branches[${#branches[@]}]="$branch"
  done < <(list_worktrees "$root" 1)

  (( ${#paths[@]} > 0 )) || die "no worktrees found for this repo"

  pr_index_load "$root" ${branches[@]+"${branches[@]}"}
  menu_init "$root" ${branches[@]+"${branches[@]}"}

  local here; here=$(git rev-parse --show-toplevel 2>/dev/null || true)
  local i menu=""
  for i in "${!paths[@]}"; do
    menu="$menu$(worktree_menu_line "$i" "${paths[$i]}" "${branches[$i]}" "$here")"$'\n'
  done

  local idx
  if have_fzf; then
    local header
    header="Worktrees for $(repo_name)   (type \"merged\" for landed work only)"
    idx=$(printf '%s' "$menu" | fzf_pick_worktrees \
      "$header"$'\n'"enter to switch to its tab (or open one), esc to cancel" \
      --no-multi 'open > ') || { echo "Cancelled."; return; }
    if [[ -z "$idx" ]]; then
      echo "Cancelled."
      return
    fi
  else
    echo "Worktrees for $(repo_name):"
    printf '%s' "$menu" | awk -F'\t' '{ printf "  %2d) %s %s %s\n", NR, $3, $4, $5 }'
    echo
    local reply
    read -r -p "Open which? (row number, blank to cancel): " reply || reply=""
    if [[ -z "${reply//[[:space:]]/}" ]]; then
      echo "Cancelled."
      return
    fi
    [[ "$reply" =~ ^[0-9]+$ ]] || die "invalid selection '$reply'"
    (( reply >= 1 && reply <= ${#paths[@]} )) || die "selection out of range: $reply"
    idx=$((reply - 1))
  fi

  local target="${paths[$idx]}"
  [[ -d "$target" ]] \
    || die "cannot open '${branches[$idx]}': $target no longer exists (stale worktree; clear it with 'wt rm')"

  echo "Opening ${branches[$idx]} at $(short_path "$target")"
  open_worktree "$target"
}

cmd_list() {
  local plain=0 a
  for a in "$@"; do
    case "$a" in
      --plain|-p) plain=1 ;;
      *) die "unknown option '$a' (see 'wt help')" ;;
    esac
  done

  local root; root=$(repo_root)
  if (( plain )); then
    git -C "$root" worktree list
    return
  fi
  cmd_ui worktrees 0
}

# Print "path<TAB>branch" for a worktree whose branch or directory is named
# after issue $2 ("1234" or "1234-anything"), or nothing. The issue picker
# flags an issue as already checked out by this same leading-number rule, so
# the two agree even once the issue title, and with it the slug, has been
# edited - or the branch in the worktree has been switched to another name.
find_worktree_for_issue() {
  local root="$1" num="$2"
  list_worktrees "$root" 0 | awk -F'\t' -v n="$num" '
    { k = split($1, d, "/"); dir = d[k] }
    $2 == n || index($2, n "-") == 1 || dir == n || index(dir, n "-") == 1 { print; exit }
  '
}

# Look up the filesystem path of the worktree for a given branch name.
find_worktree_path() {
  local root="$1" branch="$2"
  git -C "$root" worktree list --porcelain | awk -v b="refs/heads/$branch" '
    /^worktree /{p=substr($0,10)}
    /^branch /{if ($2==b) print p}
  '
}

cmd_open() {
  local branch="${1:-}"
  local root; root=$(repo_root)
  if [[ -z "$branch" ]]; then
    cmd_ui worktrees 0
    return
  fi
  local wt_path; wt_path=$(find_worktree_path "$root" "$branch")
  [[ -n "$wt_path" ]] || die "no worktree found for branch '$branch' (try 'wt list')"

  open_worktree "$wt_path"
}

# Emit "path<TAB>branch" for the repo's worktrees. Pass "1" as $2 to include
# the main working tree, which git always lists first (hence the block
# counter) and which `wt rm` must never offer.
list_worktrees() {
  local root="$1" include_main="${2:-0}"
  git -C "$root" worktree list --porcelain | awk -v inc="$include_main" '
    /^worktree /{ n++; p = substr($0, 10); b = ""; next }
    /^branch /  { b = substr($0, 8); sub(/^refs\/heads\//, "", b); next }
    /^detached/ { b = "(detached)"; next }
    /^$/        { if ((inc == 1 || n > 1) && p != "") print p "\t" b; p = ""; next }
    END         { if ((inc == 1 || n > 1) && p != "") print p "\t" b }
  '
}

# Colour, decided once per run: the menus are read by a human at a terminal,
# and anywhere else - a pipe, a NO_COLOR environment - the escapes would be
# noise. Set from the dispatcher, where stdout is still the terminal; inside
# the $(...) that builds a menu line it no longer is.
WT_COLOR=0
color_init() {
  if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    WT_COLOR=1
  else
    WT_COLOR=0
  fi
}

paint() {
  local code="$1" text="$2"
  if (( WT_COLOR )); then
    printf '\033[%sm%s\033[0m' "$code" "$text"
  else
    printf '%s' "$text"
  fi
}

# Turns `gh pr list` JSON into "<branch><TAB><label>" lines. Open pull
# requests are sorted first so that a branch reusing the name of an older,
# closed PR still shows the live one. Review and check state are only worth
# reporting while a PR is open; once it is merged or closed they are noise.
PR_LABEL_JQ='
sort_by(.state != "OPEN")
| .[]
| [ (.statusCheckRollup // [])[]
    | ((.conclusion // "") + " " + (.status // "") + " " + (.state // "")) ] as $checks
| (if .state != "OPEN" then (.state | ascii_downcase)
   elif .isDraft then "draft"
   else "open" end) as $st
| (if .state != "OPEN" then ""
   elif .reviewDecision == "APPROVED" then ", approved"
   elif .reviewDecision == "CHANGES_REQUESTED" then ", changes requested"
   else "" end) as $review
| (if .state != "OPEN" or ($checks | length) == 0 then ""
   elif any($checks[]; test("FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED")) then ", checks failing"
   elif any($checks[]; test("PENDING|QUEUED|IN_PROGRESS|WAITING|REQUESTED")) then ", checks pending"
   else ", checks passing" end) as $checkstate
| [ .headRefName, "#\(.number) \($st)\($review)\($checkstate)" ]
| @tsv
'

# Pull request state, cached in WT_PR_INDEX as "<branch><TAB><label>" lines.
# Asked for per branch rather than by listing the repo's PRs, because a busy
# repo's most recent hundred PRs are mostly other people's and would miss the
# one belonging to a worktree branched a fortnight ago. The lookups run in
# parallel since they are all network latency and nothing else.
#
# Any failure - no gh, not logged in, no GitHub remote - leaves the index
# empty on purpose: PR annotations are a nicety and must never break a menu.
WT_PR_INDEX=""
pr_index_load() {
  local root="$1"; shift
  WT_PR_INDEX=""
  if [[ "${WT_NO_PR:-0}" == "1" ]] || (( $# == 0 )); then
    return 0
  fi
  command -v gh >/dev/null 2>&1 || return 0

  local tmp
  tmp=$(mktemp -d) || return 0

  echo "Checking pull requests..." >&2
  local branch i=0
  for branch in "$@"; do
    if [[ -z "$branch" || "$branch" == "(detached)" ]]; then
      continue
    fi
    pr_lookup_branch "$root" "$branch" > "$tmp/$i" &
    i=$((i + 1))
    # Bash 3.2 has no `wait -n`, so concurrency is capped in batches instead,
    # to stay clear of GitHub's limits on a repo with many worktrees.
    if (( i % 8 == 0 )); then
      wait || true
    fi
  done
  wait || true

  WT_PR_INDEX=$(cat "$tmp"/* 2>/dev/null || true)
  rm -rf "$tmp"
}

# Print "<branch><TAB><label>" for one branch's pull request, or nothing.
pr_lookup_branch() {
  local root="$1" branch="$2"
  local fields=number,headRefName,state,isDraft,reviewDecision,statusCheckRollup
  (cd "$root" && gh pr list --head "$branch" --state all --limit 10 \
     --json "$fields" --jq "$PR_LABEL_JQ" 2>/dev/null) | head -1 || true
}

# The label for a branch's pull request ("#12 open, checks failing"), or
# nothing when it has none or the index could not be built.
pr_label_for_branch() {
  local branch="$1"
  if [[ -z "$WT_PR_INDEX" || -z "$branch" || "$branch" == "(detached)" ]]; then
    return 0
  fi
  printf '%s\n' "$WT_PR_INDEX" | awk -F'\t' -v b="$branch" '$1 == b { print $2; exit }'
}

# The bracketed, coloured mark for a PR label, or nothing for a branch with no
# pull request. Merged is the one state that means removing the worktree loses
# nothing, so it gets the tick and the green: a dozen worktrees can be scanned
# for what is safe to clear away without reading any of them.
pr_mark() {
  local pr="$1"
  case "$pr" in
    "")      return 0 ;;
    *merged) paint 32 "[✓ PR $pr]" ;;
    *closed) paint 90 "[PR $pr]" ;;
    *)       paint 33 "[PR $pr]" ;;
  esac
}

# The repo's main working tree, which git always lists first. Taken from git
# rather than from the current directory, so that running inside a worktree
# still identifies the folder its siblings live in.
main_worktree() {
  git -C "$1" worktree list --porcelain \
    | awk '/^worktree /{ print substr($0, 10); exit }'
}

# Per-run layout, worked out once from the worktrees about to be listed and
# read back by worktree_menu_line. The branch column is as wide as the longest
# branch, so the marks form a column you can run your eye down; the clamp
# keeps one absurd branch name from pushing every mark off the screen.
WT_BRANCH_WIDTH=42
WT_WORKTREE_HOME=""
menu_init() {
  local root="$1"; shift
  WT_WORKTREE_HOME="$WT_ROOT/$(basename "$(main_worktree "$root")")"

  local b w=20
  for b in "$@"; do
    if (( ${#b} > w )); then
      w=${#b}
    fi
  done
  if (( w > 56 )); then
    w=56
  fi
  WT_BRANCH_WIDTH="$w"

  WT_SESSION_TABLE=$(iterm_session_table || true)
}

# What the iTerm2 tabs in worktree $1 are doing, from the table menu_init
# loaded: a tab `wt` opened is matched by its tag, any other by the directory
# its shell last reported. When several tabs are in it, the one that most
# needs you wins. Nothing when no tab is in it, or iTerm2 could not be asked.
WT_SESSION_TABLE=""
tab_state() {
  local wt_path="$1"
  if [[ -z "$WT_SESSION_TABLE" ]]; then
    echo 0
    return 0
  fi

  local id tty path tag status rank best=0
  while IFS="$WT_FS" read -r id tty path tag status; do
    [[ -n "$id" ]] || continue
    if [[ -n "$tag" ]]; then
      [[ "$tag" == "$wt_path" ]] || continue
    else
      [[ "$path" == "$wt_path" || "$path" == "$wt_path/"* ]] || continue
    fi
    case "$status" in
      waiting) rank=4 ;;
      error)   rank=3 ;;
      working) rank=2 ;;
      *)       rank=1 ;;
    esac
    if (( rank > best )); then
      best=$rank
    fi
  done <<< "$WT_SESSION_TABLE"
  echo "$best"
}

tab_mark() {
  case "$(tab_state "$1")" in
    4) paint 35 "[claude waiting for you]" ;;
    3) paint 31 "[claude error]" ;;
    2) paint 34 "[claude working]" ;;
    1) paint 90 "[tab open]" ;;
  esac
}

# Where the worktree sits - but only when that is worth a column. `wt` puts
# everything it creates at $WT_ROOT/<repo>/<branch>, so a path per row would
# be the same string over and over, crowding out the branch names and the
# marks and getting truncated for its trouble. Anything that is not at its
# expected address still says where it is: the main working tree, a directory
# whose name no longer matches its branch, a worktree from somewhere else.
worktree_location() {
  local wt_path="$1" branch="$2"
  if [[ -z "$WT_WORKTREE_HOME" || "$wt_path" == "$WT_WORKTREE_HOME/$branch" ]]; then
    return 0
  fi
  if [[ "$wt_path" == "$WT_WORKTREE_HOME/"* ]]; then
    # Only the leaf, and only a hint's worth of it: the point is that the
    # directory is not named after the branch, not what it is called. The
    # preview pane carries the path in full.
    local dir="${wt_path#"$WT_WORKTREE_HOME"/}"
    if (( ${#dir} > 30 )); then
      dir="${dir:0:27}..."
    fi
    paint 90 "in $dir"
    return 0
  fi
  paint 90 "$(short_path "$wt_path")"
}

# Format one worktree as a menu line:
# "<index><TAB><path><TAB><branch><TAB><marks><TAB><location>".
# fzf displays fields 3.. and hands back the index. Matching is limited to the
# branch name, the marks and the location hint, so a long shared path prefix
# cannot match everything, while typing "merged" narrows the list to what is
# safe to remove - and typing an issue number still finds a worktree whose
# branch has been switched away from the name its directory carries.
worktree_menu_line() {
  local idx="$1" wt_path="$2" branch="$3" here="$4" current_label="${5:-current}"
  local marks="" mark
  mark=$(pr_mark "$(pr_label_for_branch "$branch")")
  if [[ -n "$mark" ]]; then
    marks="$marks $mark"
  fi
  if [[ -d "$wt_path" ]]; then
    if worktree_is_dirty "$wt_path"; then
      marks="$marks $(paint 31 "[uncommitted changes]")"
    fi
  else
    marks="$marks $(paint 90 "[missing, stale entry]")"
  fi
  mark=$(tab_mark "$wt_path")
  if [[ -n "$mark" ]]; then
    marks="$marks $mark"
  fi
  if [[ "$wt_path" == "$here" ]]; then
    marks="$marks $(paint 36 "[$current_label]")"
  fi
  printf '%s\t%s\t%-*s\t%s\t%s' \
    "$idx" "$wt_path" "$WT_BRANCH_WIDTH" "$branch" "${marks# }" \
    "$(worktree_location "$wt_path" "$branch")"
}

# What the fzf preview pane shows for the worktree at $1. A subcommand rather
# than a quoted one-liner inside the fzf call, so that it can be read, and
# checked by shellcheck, like the rest of the script.
#
# Colour is forced on here even though stdout is a pipe: it is a pipe straight
# into fzf, which renders it. NO_COLOR still wins.
cmd_preview() {
  local wt_path="${1:-}"
  if [[ -z "$wt_path" || ! -d "$wt_path" ]]; then
    echo "(directory is missing - stale registration)"
    return
  fi

  local -a git_color=(-c color.ui=always)
  local bold=$'\033[1m' plain=$'\033[0m'
  if [[ -n "${NO_COLOR:-}" ]]; then
    git_color=(-c color.ui=never)
    bold=""
    plain=""
  fi

  printf '%s%s%s\n\n' "$bold" "$(short_path "$wt_path")" "$plain"
  git -C "$wt_path" "${git_color[@]}" status --short --branch
  echo
  git -C "$wt_path" "${git_color[@]}" log --oneline --decorate -8
  echo

  if [[ "${WT_NO_PR:-0}" == "1" ]] || ! command -v gh >/dev/null 2>&1; then
    return
  fi

  # Told to behave as though it were on a terminal, `gh` renders the
  # description as markdown - headings, bold, code, tables - and prints a
  # readable header instead of the raw source and a column of empty fields,
  # which is what it falls back to when its output is a pipe. The width is
  # the preview pane's own, so the wrapping matches the box it lands in.
  (
    cd "$wt_path" \
      && GH_FORCE_TTY="${FZF_PREVIEW_COLUMNS:-80}" gh pr view 2>/dev/null
  ) || echo "(no pull request for this branch)"
}

# Run fzf over worktree menu lines on stdin, printing the chosen index(es).
# $1 = header, $2 = --multi or --no-multi, $3 = prompt.
fzf_pick_worktrees() {
  # The pull request is fetched per highlighted row rather than up front, so
  # the round trip only happens for worktrees the user actually stops on.
  fzf --delimiter=$'\t' --with-nth=3.. --nth=1,2,3 --ansi \
    --height=90% --border --reverse "$2" \
    --prompt="$3" --header="$1" \
    --preview="$(printf '%q' "$WT_SELF") __preview {2}" \
    --preview-window='right:48%:wrap' \
  | cut -f1
}

# Abbreviate $HOME to ~ so long worktree paths stay readable in menus.
short_path() {
  local p="$1"
  if [[ "$p" == "$HOME"/* ]]; then
    echo "~${p#"$HOME"}"
  else
    echo "$p"
  fi
}

worktree_is_dirty() {
  [[ -n "$(git -C "$1" status --porcelain 2>/dev/null)" ]]
}

# True while $2 is still registered as a worktree of the repo at $1. Matched by
# path, so it also covers detached worktrees that have no branch name.
worktree_is_registered() {
  local root="$1" wt_path="$2"
  git -C "$root" worktree list --porcelain \
    | awk -v p="worktree $wt_path" '$0 == p { found = 1 } END { exit !found }'
}

# Remove one worktree, warning first if it holds uncommitted work, then offer
# to delete its branch.
remove_one_worktree() {
  local wt_path="$1" branch="$2"
  local root; root=$(repo_root)
  local here; here=$(git rev-parse --show-toplevel 2>/dev/null || true)
  local yn

  if [[ "$wt_path" == "$here" ]]; then
    echo "Skipping '$branch': that is the worktree you are standing in." >&2
    return
  fi

  # Collected before the directory goes, while iTerm2 can still say which of
  # its tabs are sitting in it.
  local -a tabs=()
  local session_id status working=0
  while read -r session_id status; do
    [[ -n "$session_id" ]] || continue
    if [[ "$status" == "working" ]]; then
      working=1
    fi
    if [[ "${WT_KEEP_TABS:-0}" != "1" ]]; then
      tabs[${#tabs[@]}]="$session_id"
    fi
  done < <(iterm_sessions_in "$wt_path")

  # A claude still in the middle of a turn is about to have its tree pulled
  # out from under it, and whatever it was doing lost. Known only through
  # iTerm2's Claude Code integration; without it, nothing is reported here.
  if (( working )); then
    read -r -p "Claude is still working in '$branch'. Remove it anyway? [y/N] " yn || yn="n"
    if [[ ! "$yn" =~ ^[Yy]$ ]]; then
      echo "Skipping '$branch'."
      return
    fi
  fi

  # A worktree whose directory is already gone is just a stale registration.
  # There is no work left to lose, so deregister it without prompting.
  if [[ -d "$wt_path" ]]; then
    if worktree_is_dirty "$wt_path"; then
      read -r -p "'$branch' has uncommitted changes. Discard them? [y/N] " yn || yn="n"
      if [[ ! "$yn" =~ ^[Yy]$ ]]; then
        echo "Skipping '$branch'."
        return
      fi
    fi
  else
    echo "'$branch': directory already gone, deregistering stale worktree."
  fi

  local out rc=0
  out=$(git -C "$root" worktree remove "$wt_path" --force 2>&1) || rc=$?
  if (( rc == 0 )); then
    echo "Removed worktree at $wt_path"
  elif [[ ! -d "$wt_path" ]]; then
    # Older git refuses to remove a worktree whose directory has vanished;
    # prune clears the stale registration instead.
    git -C "$root" worktree prune
    if worktree_is_registered "$root" "$wt_path"; then
      echo "$out" >&2
      die "could not deregister stale worktree at $wt_path"
    fi
    echo "Deregistered stale worktree $wt_path"
  else
    echo "$out" >&2
    die "could not remove worktree at $wt_path"
  fi

  # The directory is gone, so a tab left open in it is stranded: every command
  # it runs fails on a working directory that no longer exists, and a `claude`
  # in it has lost the tree it was working on. Closed after the removal
  # succeeds, never before, so a refusal leaves the session alone.
  if (( ${#tabs[@]} > 0 )); then
    for session_id in "${tabs[@]}"; do
      close_iterm_session "$session_id"
    done
    if (( ${#tabs[@]} == 1 )); then
      echo "Closed the iTerm2 tab that was in it"
    else
      echo "Closed ${#tabs[@]} iTerm2 tabs that were in it"
    fi
  fi

  if [[ "$branch" != "(detached)" ]] \
     && git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
    read -r -p "Delete local branch '$branch' too? [y/N] " yn || yn="n"
    if [[ "$yn" =~ ^[Yy]$ ]]; then
      git -C "$root" branch -D "$branch"
    fi
  fi
}

cmd_rm() {
  local root; root=$(repo_root)

  # Explicit branch name: remove it directly, no menu.
  if [[ -n "${1:-}" ]]; then
    local wt_path; wt_path=$(find_worktree_path "$root" "$1")
    [[ -n "$wt_path" ]] || die "no worktree found for branch '$1' (try 'wt list')"
    pr_index_load "$root" "$1"
    local pr; pr=$(pr_label_for_branch "$1")
    if [[ -n "$pr" ]]; then
      echo "Pull request: $(pr_mark "$pr")"
    fi
    remove_one_worktree "$wt_path" "$1"
    return
  fi

  # No argument: offer the picker, and come back to it after each removal so a
  # handful of worktrees can be cleared out one decision at a time. Only
  # cancelling the picker - or running out of worktrees - ends the session.
  if [[ -z "$(list_worktrees "$root" 0)" ]]; then
    die "no linked worktrees for this repo (the main working tree is not removable)"
  fi
  local first=1
  while rm_menu_round "$root" "$first"; do
    first=0
    if [[ -z "$(list_worktrees "$root" 0)" ]]; then
      echo
      echo "No linked worktrees left."
      return
    fi
    echo
  done
}

# One pass of the `wt rm` picker: pick, remove. Returns non-zero when the user
# cancels the picker, which is what ends the loop in cmd_rm. Pull requests are
# looked up on the first pass alone: removing worktrees only ever shrinks the
# set of branches, so the index already holds every one a later pass can show.
rm_menu_round() {
  local root="$1" first="$2"
  local -a paths=() branches=()
  local path branch
  while IFS=$'\t' read -r path branch; do
    [[ -n "$path" ]] || continue
    paths[${#paths[@]}]="$path"
    branches[${#branches[@]}]="$branch"
  done < <(list_worktrees "$root" 0)

  (( ${#paths[@]} > 0 )) || return 1

  if [[ "$first" == "1" ]]; then
    pr_index_load "$root" ${branches[@]+"${branches[@]}"}
  fi
  menu_init "$root" ${branches[@]+"${branches[@]}"}

  local here; here=$(git rev-parse --show-toplevel 2>/dev/null || true)

  # Menu lines are "<index><TAB><path><TAB><branch><TAB><detail>". fzf displays
  # fields 3.. and hands back the index; --nth=1 keeps typing matched against
  # the branch name only, so a long shared path prefix cannot match everything.
  local i menu=""
  for i in "${!paths[@]}"; do
    menu="$menu$(worktree_menu_line "$i" "${paths[$i]}" "${branches[$i]}" \
      "$here" "current, cannot remove")"$'\n'
  done

  local -a chosen=()
  local reply

  if have_fzf; then
    local sel
    local header
    header="Worktrees for $(repo_name)   (type \"merged\" for landed work only)"
    sel=$(printf '%s' "$menu" | fzf_pick_worktrees \
      "$header"$'\n'"tab to mark several, enter to confirm, esc to cancel" \
      --multi 'remove > ') || { echo "Cancelled."; return 1; }
    if [[ -z "$sel" ]]; then
      echo "Cancelled."
      return 1
    fi
    while read -r i; do
      [[ -n "$i" ]] || continue
      chosen[${#chosen[@]}]="$i"
    done <<< "$sel"
  else
    echo "Worktrees for $(repo_name):"
    printf '%s' "$menu" | awk -F'\t' '{ printf "  %2d) %s %s %s\n", NR, $3, $4, $5 }'
    echo
    read -r -p "Remove which? (e.g. '1 3', 'all', blank to cancel): " reply
    if [[ -z "${reply//[[:space:]]/}" ]]; then
      echo "Cancelled."
      return 1
    fi
    if [[ "$reply" == "all" ]]; then
      chosen=("${!paths[@]}")
    else
      local -a toks=()
      local tok
      read -ra toks <<< "${reply//,/ }"
      for tok in ${toks[@]+"${toks[@]}"}; do
        [[ "$tok" =~ ^[0-9]+$ ]] || die "invalid selection '$tok'"
        (( tok >= 1 && tok <= ${#paths[@]} )) || die "selection out of range: $tok"
        chosen[${#chosen[@]}]="$((tok - 1))"
      done
    fi
  fi

  (( ${#chosen[@]} > 0 )) || { echo "Cancelled."; return 1; }

  # Picking in a picker that only removes is the decision; asking again on top
  # of it is noise. Dirty worktrees still get their own prompt below.
  for i in "${chosen[@]}"; do
    echo
    remove_one_worktree "${paths[$i]}" "${branches[$i]}"
  done
  return 0
}

# ---------------------------------------------------------------------------
# The picker `wt` opens: one fzf session with a tab per source - issues, pull
# requests, Jira tickets, worktrees - switched with tab / shift-tab. Enter does
# the obvious thing wherever it is pressed: switch to the worktree, or create
# it first.
#
# fzf calls back into this script (`wt __ui <action>`) to fill the list, to
# switch tabs and to act on rows, and keeps nothing between those calls but
# what is in the directory $WT_UI: which tab is showing, whether "mine" is on,
# and each source's fetched lines, so that a tab already seen comes back
# without asking the network again. Every row is "<kind><TAB><id><TAB>..." -
# kind is issue, pr, jira, wt or msg - and fzf shows fields 3 onwards.
# ---------------------------------------------------------------------------

ui_get() { cat "$WT_UI/$1" 2>/dev/null || true; }
ui_set() { printf '%s' "$2" > "$WT_UI/$1"; }

# The tabs on offer, in order: the GitHub ones when gh is there, Jira when it
# is set up, and always the worktrees.
ui_tabs() {
  local t=""
  if command -v gh >/dev/null 2>&1; then
    t="issues prs"
  fi
  if jira_enabled; then
    t="$t jira"
  fi
  t="$t worktrees"
  echo "${t# }"
}

ui_title() {
  case "$1" in
    issues)    echo "Issues" ;;
    prs)       echo "Pull requests" ;;
    jira)      echo "Jira" ;;
    worktrees) echo "Worktrees" ;;
  esac
}

# How many rows tab $1 has, when that is known without waiting for anything.
ui_count() {
  local tab="$1" f
  if [[ "$tab" == "worktrees" ]]; then
    list_worktrees "$(ui_get root)" 1 | grep -c '' || true
    return 0
  fi
  f="$WT_UI/raw-$tab-$(ui_get mine)"
  [[ -f "$f" ]] || return 0
  grep -c . "$f" || true
}

# The tab strip, shown in the top border: the tab showing in reverse, the
# rest dimmed, each with its count once that is known.
ui_strip() {
  local current; current=$(ui_get tab)
  local tab n text out=" "
  for tab in $(ui_get tabs); do
    text="$(ui_title "$tab")"
    n=$(ui_count "$tab")
    [[ -z "$n" ]] || text="$text $n"
    if [[ "$tab" == "$current" ]]; then
      out="$out$(paint '1;7' " $text ")  "
    else
      out="$out$(paint 90 " $text ")  "
    fi
  done
  if [[ "$(ui_get mine)" == "1" ]]; then
    out="$out$(paint 33 "[mine]") "
  fi
  printf '%s' "$out"
}

ui_prompt() { printf '%s > ' "$(ui_get tab)"; }

ui_hints() {
  if [[ "$(ui_get tab)" == "worktrees" ]]; then
    echo "tab next view · enter open · ctrl-space mark · ctrl-x remove · esc quit"
  else
    echo "tab next view · enter open or create · alt-m only mine · esc quit"
  fi
}

# The fzf actions that redraw everything after the tab or "mine" changed. The
# strip goes last because it holds escape codes, whose "[" no bracket pair
# could contain; the colon form takes the rest of the line as it is.
ui_redraw_actions() {
  local self; self=$(printf '%q' "$WT_SELF")
  printf 'clear-selection+reload(%s __ui rows)+change-prompt(%s)+change-header(%s)+change-border-label:%s' \
    "$self" "$(ui_prompt)" "$(ui_hints)" "$(ui_strip)"
}

# Fetch source $1's lines for "mine" $2 into $WT_UI/raw-$1-$2, or leave why
# not in raw-$1-$2.err. The .pending marker tells ui_raw a fetch is under way.
ui_fetch_to() {
  local src="$1" mine="$2" root="$3"
  local f="$WT_UI/raw-$src-$mine" out
  if out=$(ui_fetch "$src" "$mine" "$root" 2>"$f.stderr"); then
    printf '%s\n' "$out" > "$f.tmp" && mv "$f.tmp" "$f"
  else
    grep . "$f.stderr" | head -3 > "$f.err" || true
    [[ -s "$f.err" ]] || echo "could not list $(ui_title "$src" | tr '[:upper:]' '[:lower:]')" > "$f.err"
  fi
  rm -f "$f.pending" "$f.stderr"
}

ui_fetch() {
  local src="$1" mine="$2" root="$3"
  case "$src" in
    issues) fetch_issues "$root" "$mine" ;;
    prs)    fetch_prs "$root" "$mine" ;;
    # Jira answers a search with rejected credentials as if from an
    # anonymous visitor - with nothing - so the login is checked first.
    jira)   jira_check_login && jira_search "$(jira_picker_jql "$mine")" ;;
  esac
}

# Print source $1's lines for "mine" $2: from the cache, from a fetch already
# under way (waited for), or fetched now. Fails, with the reason printed, when
# the fetch did.
ui_raw() {
  local src="$1" mine="$2" root="$3"
  local f="$WT_UI/raw-$src-$mine" tries=0
  while [[ -f "$f.pending" && ! -f "$f" && ! -f "$f.err" ]] && (( tries < 600 )); do
    sleep 0.1
    tries=$((tries + 1))
  done
  if [[ ! -f "$f" && ! -f "$f.err" ]]; then
    ui_fetch_to "$src" "$mine" "$root"
  fi
  if [[ -f "$f.err" ]]; then
    cat "$f.err"
    return 1
  fi
  cat "$f"
}

# Look up the pull request labels of the worktrees into $WT_UI/pr-index.
ui_pr_index_build() {
  local root="$1" f="$WT_UI/pr-index"
  local -a branches=()
  local p b
  while IFS=$'\t' read -r p b; do
    [[ -n "$p" ]] || continue
    branches[${#branches[@]}]="$b"
  done < <(list_worktrees "$root" 1)
  pr_index_load "$root" ${branches[@]+"${branches[@]}"} 2>/dev/null || true
  printf '%s' "$WT_PR_INDEX" > "$f.tmp" && mv "$f.tmp" "$f"
  rm -f "$f.pending"
}

# The pull request labels of the worktrees, looked up once per picker: from
# the lookup started in the background, or now.
ui_pr_index() {
  local root="$1" f="$WT_UI/pr-index" tries=0
  while [[ -f "$f.pending" && ! -f "$f" ]] && (( tries < 600 )); do
    sleep 0.1
    tries=$((tries + 1))
  done
  [[ -f "$f" ]] || ui_pr_index_build "$root"
  cat "$f"
}

# A row that only says something; enter and ctrl-x pass over it.
ui_msg() { printf 'msg\t\t%s\n' "$(paint "${2:-90}" "$1")"; }

# `wt __ui rows`: the rows of the tab showing.
ui_rows() {
  local root tab mine
  root=$(ui_get root)
  tab=$(ui_get tab)
  mine=$(ui_get mine)
  WT_COLOR=$(ui_get color)
  WT_SESSION_TABLE=$(iterm_session_table || true)

  if [[ "$tab" == "worktrees" ]]; then
    local -a paths=() branches=()
    local path branch
    while IFS=$'\t' read -r path branch; do
      [[ -n "$path" ]] || continue
      paths[${#paths[@]}]="$path"
      branches[${#branches[@]}]="$branch"
    done < <(list_worktrees "$root" 1)
    WT_PR_INDEX=$(ui_pr_index "$root")
    menu_init "$root" ${branches[@]+"${branches[@]}"}
    local here i
    here=$(ui_get here)
    for i in "${!paths[@]}"; do
      printf 'wt\t%s\n' "$(worktree_menu_line "$i" "${paths[$i]}" "${branches[$i]}" "$here" | cut -f2-)"
    done
    return 0
  fi

  local raw kind rows
  if ! raw=$(ui_raw "$tab" "$mine" "$root"); then
    while IFS= read -r line; do
      ui_msg "$line" 31
    done <<< "$raw"
    return 0
  fi
  case "$tab" in
    issues) kind="issue"; rows=$(issue_rows "$root" "$raw") ;;
    prs)    kind="pr";    rows=$(pr_rows "$root" "$raw") ;;
    jira)   kind="jira";  rows=$(jira_rows "$root" "$raw") ;;
  esac
  if [[ -z "$rows" ]]; then
    if [[ "$mine" == "1" ]]; then
      ui_msg "Nothing open of yours here (alt-m shows everyone's)"
    else
      ui_msg "Nothing open here"
    fi
    return 0
  fi
  printf '%s\n' "$rows" | sed "s/^/$kind$(printf '\t')/"
}

# `wt __ui switch 1|-1`: move to the next or previous tab.
ui_switch() {
  local step="${1:-1}"
  local -a tabs=()
  local t i=0 at=0
  for t in $(ui_get tabs); do
    tabs[${#tabs[@]}]="$t"
    [[ "$t" != "$(ui_get tab)" ]] || at=$i
    i=$((i + 1))
  done
  at=$(( (at + step + ${#tabs[@]}) % ${#tabs[@]} ))
  ui_set tab "${tabs[$at]}"
  WT_COLOR=$(ui_get color)
  ui_redraw_actions
}

# `wt __ui mine`: show only your own issues, pull requests and tickets, or
# everyone's again.
ui_mine() {
  if [[ "$(ui_get mine)" == "1" ]]; then
    ui_set mine 0
  else
    ui_set mine 1
  fi
  WT_COLOR=$(ui_get color)
  ui_redraw_actions
}

# `wt __ui rm-key`: what ctrl-x does - remove the marked worktrees, or the one
# under the cursor, but only on the worktrees tab.
ui_rm_key() {
  [[ "$(ui_get tab)" == "worktrees" ]] || return 0
  local self; self=$(printf '%q' "$WT_SELF")
  printf 'execute(%s __ui rm {+f})+clear-selection+reload(%s __ui rows)' "$self" "$self"
}

# `wt __ui rm <file>`: remove the worktrees on the rows listed in the file,
# asking what remove_one_worktree asks, then wait for a key so the outcome can
# be read before fzf draws over it.
ui_rm() {
  local file="$1" root main kind path rest branch n=0
  root=$(ui_get root)
  main=$(main_worktree "$root")
  # fzf leaves its list on screen under a command it runs; clear it first, so
  # the questions are not printed over the rows.
  printf '\033[H\033[J'
  while IFS=$'\t' read -r kind path rest; do
    [[ "$kind" == "wt" && -n "$path" ]] || continue
    n=$((n + 1))
    echo
    if [[ "$path" == "$main" ]]; then
      echo "Skipping the main working tree: it cannot be removed."
      continue
    fi
    branch=$(list_worktrees "$root" 0 | awk -F'\t' -v p="$path" '$1 == p { print $2; exit }')
    ( remove_one_worktree "$path" "${branch:-(detached)}" ) < /dev/tty || true
  done < "$file"
  (( n > 0 )) || return 0
  echo
  read -r -s -n 1 -p "Press any key to go back to the picker." < /dev/tty || true
}

# `wt __ui preview <kind> <id>`
ui_preview() {
  local kind="$1" id="${2:-}" root
  root=$(ui_get root)
  case "$kind" in
    wt)    cmd_preview "$id" ;;
    issue) (cd "$root" && GH_FORCE_TTY="${FZF_PREVIEW_COLUMNS:-80}" gh issue view "$id" 2>&1) ;;
    pr)    (cd "$root" && GH_FORCE_TTY="${FZF_PREVIEW_COLUMNS:-80}" gh pr view "$id" 2>&1) ;;
    jira)  cmd_jira_preview "$id" ;;
  esac
}

# `wt __ui go <kind> <id>`: what enter does, run in place of fzf once it
# closes. Everything but a worktree goes through `wt new`, which switches to
# the worktree when there already is one.
ui_go() {
  local kind="$1" id="${2:-}"
  case "$kind" in
    wt)
      [[ -d "$id" ]] \
        || die "$(short_path "$id") no longer exists (stale worktree; clear it with ctrl-x)"
      echo "Opening $(short_path "$id")"
      open_worktree "$id"
      ;;
    issue) cmd_new "$id" ;;
    pr)    cmd_new --pr "$id" ;;
    jira)  cmd_new --jira "$id" ;;
  esac
}

# Open the picker on tab $1 ("issues", "prs", "jira" or "worktrees"), with
# "mine" $2. Without fzf there are no tabs, and the numbered menu of that one
# source is offered instead.
cmd_ui() {
  local tab="${1:-issues}" mine="${2:-0}"
  local root; root=$(repo_root)

  if ! have_fzf; then
    case "$tab" in
      worktrees) pick_worktree_and_open "$root" ;;
      prs)       if (( mine )); then cmd_new --pr --mine; else cmd_new --pr; fi ;;
      jira)      if (( mine )); then cmd_new --jira --mine; else cmd_new --jira; fi ;;
      *)         if (( mine )); then cmd_new --mine; else cmd_new; fi ;;
    esac
    return
  fi

  local tabs; tabs=$(ui_tabs)
  if [[ " $tabs " != *" $tab "* ]]; then
    tab="${tabs%% *}"
  fi

  WT_UI=$(mktemp -d "${TMPDIR:-/tmp}/wt-ui.XXXXXX") || die "could not create a temporary directory"
  export WT_UI
  trap 'rm -rf "$WT_UI"' EXIT
  ui_set root "$root"
  ui_set tabs "$tabs"
  ui_set tab "$tab"
  ui_set mine "$mine"
  ui_set color "$WT_COLOR"
  ui_set here "$(git rev-parse --show-toplevel 2>/dev/null || true)"

  # Every source starts loading now, in the background, so that by the time
  # a tab is switched to its list is usually there already.
  local t
  for t in $tabs; do
    [[ "$t" != "worktrees" ]] || continue
    : > "$WT_UI/raw-$t-$mine.pending"
    ( ui_fetch_to "$t" "$mine" "$root" ) >/dev/null 2>&1 &
  done
  : > "$WT_UI/pr-index.pending"
  ( ui_pr_index_build "$root" ) >/dev/null 2>&1 &

  local self; self=$(printf '%q' "$WT_SELF")
  fzf --ansi --multi --delimiter=$'\t' --with-nth=3.. \
    --height=90% --border --reverse --border-label-pos=2 \
    --prompt="$(ui_prompt)" --header="$(ui_hints)" --border-label="$(ui_strip)" \
    --preview="$self __ui preview {1} {2}" --preview-window='right:48%:wrap' \
    --bind="start:reload($self __ui rows)" \
    --bind="load:transform-border-label($self __ui strip)" \
    --bind="tab:transform($self __ui switch 1)" \
    --bind="shift-tab:transform($self __ui switch -1)" \
    --bind="ctrl-space:toggle" \
    --bind="alt-m:transform($self __ui mine)" \
    --bind="ctrl-x:transform($self __ui rm-key)" \
    --bind="enter:become($self __ui go {1} {2})" \
    < /dev/null || true
}

cmd_ui_action() {
  [[ -n "${WT_UI:-}" && -d "$WT_UI" ]] || die "'wt __ui' is only for the picker to call"
  local action="${1:-}"
  shift || true
  case "$action" in
    rows)    ui_rows ;;
    strip)   WT_COLOR=$(ui_get color); ui_strip ;;
    switch)  ui_switch "$@" ;;
    mine)    ui_mine ;;
    rm-key)  ui_rm_key ;;
    rm)      ui_rm "$@" ;;
    preview) ui_preview "$@" ;;
    go)      ui_go "$@" ;;
    *)       die "unknown picker action '$action'" ;;
  esac
}

usage() {
  cat <<'EOF'
wt - git worktree helper with GitHub and Jira integration and iTerm2 automation

Usage:
  wt                      Open the picker: a tab each for issues, pull requests,
                          Jira tickets and worktrees (tab switches; enter goes
                          to the worktree, creating it if need be; alt-m only
                          mine; ctrl-x removes a worktree, ctrl-space marks)
  wt new                  Pick an open GitHub issue from a list, then branch from it
  wt new --mine           Same, narrowed to issues assigned to you
  wt new <issue-number>   Create a worktree/branch named after GitHub issue #<n>
  wt new --pr [--mine]    Pick an open pull request (--mine: ones you opened)
                          and check out its branch
  wt new --pr <number>    Check out pull request #<n>'s branch
  wt new --jira [--mine]  Pick an open Jira ticket (--mine: assigned to you)
  wt new <TICKET-KEY>     Create a worktree/branch named after a Jira ticket
  wt new <url>            Same, from a GitHub issue or pull request link or a
                          Jira /browse/ link
  wt new <branch-name>    Create a worktree/branch with an explicit name
  wt list                 Pick a worktree and switch to its iTerm2 tab
                          (a new tab is opened if it has none)
  wt list --plain         Print plain "git worktree list" output
                          (in either picker, type "merged" to see only the
                          worktrees whose pull request has landed)
  wt open [branch]        Same as "wt list"; with a branch, opens it directly
  wt rm [branch]          Remove a worktree; with no argument, pick from a list
  wt --version            Print the installed version

Env vars:
  WT_ROOT          Where worktrees are stored (default: ~/worktrees)
  WT_BASE_BRANCH   Base branch to branch from (default: repo's default branch)
  WT_NO_CLAUDE     Set to "1" to skip auto-running claude in the new tab
  WT_CLAUDE_ARGS   Args passed to claude (default: --permission-mode auto)
  WT_ISSUE_LIMIT   Most items a picker fetches (default: 1000)
  WT_PROMPT_TEMPLATE
                   Prompt typed (unsent) into claude in a NEW issue worktree;
                   "{url}" becomes the issue URL. Set empty to disable.
  WT_PR_PROMPT_TEMPLATE, WT_JIRA_PROMPT_TEMPLATE
                   The same, for a pull request's or a Jira ticket's worktree
  WT_PREFILL_DELAY Seconds to wait before typing that prompt (default: 6)
  WT_NO_PULL       Set to "1" to fetch only, leaving the local base branch put
  WT_NO_PR         Set to "1" to skip pull request lookups in the menus
  NO_COLOR         Set to anything to turn off colour in the pickers
  WT_KEEP_TABS     Set to "1" to leave a removed worktree's iTerm2 tabs open
  WT_NO_TAB_TITLE  Set to "1" to keep "PR #<n>" out of the tab title
  WT_NEW_TAB       Set to "1" to always open a new tab, even when the worktree
                   already has one

Jira (Cloud), needs curl and jq:
  WT_JIRA_URL      Your site, e.g. https://example.atlassian.net (required)
  WT_JIRA_EMAIL    Atlassian account (default: git config --global user.email)
  WT_JIRA_TOKEN    API token; better kept in the keychain instead (copy the
                   token, then store it from the clipboard - the prompt
                   that "-w" alone gives cuts it at 128 characters):
                     security add-generic-password -U -s wt-jira -a <email> -w "$(pbpaste)"
  WT_JIRA_PROJECT  Project the picker lists open tickets of (without it,
                   the picker lists your own open tickets)
  WT_JIRA_JQL      JQL filter replacing the picker's default (no ORDER BY)
EOF
}

color_init

case "${1:-}" in
  new)  shift; cmd_new "$@" ;;
  list) shift; cmd_list "$@" ;;
  open) shift; cmd_open "$@" ;;
  rm)   shift; cmd_rm "$@" ;;
  __preview) shift; cmd_preview "$@" ;;
  __jira-preview) shift; cmd_jira_preview "$@" ;;
  __tab-title) shift; cmd_tab_title "$@" ;;
  __ui) shift; cmd_ui_action "$@" ;;
  -V|--version|version) echo "wt $WT_VERSION" ;;
  "") cmd_ui issues 0 ;;
  -h|--help|help) usage ;;
  *) die "unknown command '$1' (see 'wt help')" ;;
esac
