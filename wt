#!/usr/bin/env bash
#
# wt - git worktree helper with GitHub issue integration and iTerm2 automation
#
# Creates a git worktree (optionally named after a GitHub issue), stores it in
# a centralized folder, and opens it in a new iTerm2 tab with `claude` running.
#
# Usage:
#   wt new                    Pick an open GitHub issue from a list, then branch from it
#   wt new --mine             Same, narrowed to issues assigned to you
#   wt new <issue-number>     Create a worktree/branch named after GitHub issue #<n>
#   wt new <branch-name>      Create a worktree/branch with an explicit name
#   wt list                   Pick a worktree and reopen it in a new iTerm2 tab
#   wt list --plain           Print the plain `git worktree list` output
#   wt open [branch]          Same as `wt list`; with a branch, opens it directly
#   wt rm [branch]            Remove a worktree; with no argument, pick from a list
#
# Env vars:
#   WT_ROOT          Where worktrees are stored (default: ~/worktrees)
#   WT_BASE_BRANCH   Base branch to branch from (default: repo's default branch)
#   WT_NO_CLAUDE     If set to "1", don't auto-run `claude` in the new tab
#   WT_CLAUDE_ARGS   Args passed to claude (default: --permission-mode auto;
#                    set to empty to launch plain `claude`)
#   WT_ISSUE_LIMIT   How many issues to show in the picker (default: 30)
#   WT_PROMPT_TEMPLATE
#                    Prompt typed into claude (left unsent) in a newly created
#                    worktree whose branch is named after an issue; "{url}" is
#                    replaced with the issue URL. Set empty to disable.
#   WT_PREFILL_DELAY Seconds to wait for claude to start before typing the
#                    prompt (default: 6)
#   WT_NO_PULL       If set to "1", only fetch on `wt new`; don't fast-forward
#                    the local base branch
#   WT_NO_PR         If set to "1", don't look up pull requests at all
#   NO_COLOR         If set, don't colour the pickers
#   WT_KEEP_TABS     If set to "1", don't close the iTerm2 tabs of a removed
#                    worktree
#   WT_NO_TAB_TITLE  If set to "1", don't put the pull request number in the
#                    tab title of a claude that `wt` starts
#
# Requirements: git, iTerm2 (macOS), and optionally `gh` (for issue lookups)
# and `fzf` (for arrow-key pickers; falls back to a numbered menu without it).

set -euo pipefail

WT_ROOT="${WT_ROOT:-$HOME/worktrees}"

# New tabs start Claude Code in auto mode. Set WT_CLAUDE_ARGS="" for a plain
# `claude`, or WT_NO_CLAUDE=1 to skip launching it at all.
: "${WT_CLAUDE_ARGS=--permission-mode auto}"

# Seeded as claude's first prompt when a worktree's branch is named after a
# GitHub issue. "{url}" is replaced with that issue's URL. Assigned the long
# way round because a "}" inside ${var=default} would end the expansion early.
if [[ -z "${WT_PROMPT_TEMPLATE+set}" ]]; then
  WT_PROMPT_TEMPLATE='Work on this GitHub issue: {url}'
fi

# This script's own path, so that the fzf preview can call back into it. A
# bare name is left alone for the preview shell to find on PATH; a relative
# one is anchored now, while the current directory is still known.
WT_SELF="$0"
if [[ "$WT_SELF" != /* && "$WT_SELF" == */* ]]; then
  WT_SELF="$PWD/$WT_SELF"
fi

die() { echo "Error: $*" >&2; exit 1; }

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"
}

repo_name() {
  basename "$(repo_root)"
}

default_branch() {
  local root="$1"
  git -C "$root" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null \
    | sed 's@^refs/remotes/origin/@@' \
    || echo main
}

slugify() {
  echo "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g' \
    | cut -c1-50
}

# Escape a string for use inside an AppleScript double-quoted literal.
applescript_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

# Open $1 (a directory) in a new iTerm2 tab and run $2 (a shell command) there.
# $3, if given, is typed into the running program afterwards WITHOUT a newline,
# so it sits in the prompt box until the user presses enter themselves.
open_iterm_tab() {
  local dir="$1"
  local cmd="${2:-}"
  local prefill="${3:-}"
  local full_cmd; full_cmd="cd $(printf '%q' "$dir")"
  if [[ -n "$cmd" ]]; then
    full_cmd="$full_cmd && $cmd"
  fi
  full_cmd=$(applescript_escape "$full_cmd")

  # Typed only after a pause, since claude needs a moment to draw its prompt
  # box and anything sent before that is dropped.
  local prefill_script=""
  if [[ -n "$prefill" ]]; then
    local delay="${WT_PREFILL_DELAY:-6}"
    [[ "$delay" =~ ^[0-9]+([.][0-9]+)?$ ]] \
      || die "WT_PREFILL_DELAY must be a number of seconds, not '$delay'"
    prefill_script="    delay $delay
    write text \"$(applescript_escape "$prefill")\" newline no"
  fi

  # The new session is captured before anything is written to it. Addressing
  # "current session of current window" instead would re-resolve on every
  # command, so the prefill typed after the delay would land in whatever tab
  # the user had switched to by then.
  osascript <<APPLESCRIPT
tell application "iTerm2"
  activate
  if (count of windows) = 0 then
    set theWindow to (create window with default profile)
  else
    set theWindow to current window
    tell theWindow to create tab with default profile
  end if
  set theSession to current session of theWindow
  tell theSession
    write text "$full_cmd"
$prefill_script
  end tell
end tell
APPLESCRIPT
}

have_fzf() { command -v fzf >/dev/null 2>&1; }

# True when anything running on terminal $1 is sitting in $2, or below it.
# Asked of the kernel rather than of iTerm2, whose own "session.path" only
# refreshes when the shell draws a prompt: a tab that has been running
# `claude` since `wt` opened it still reports whatever directory it was in
# before, which is exactly the tab that needs finding.
tty_is_in() {
  local tty="${1#/dev/}" dir="$2"

  # lsof lives in /usr/sbin, which a login shell has on its PATH and a leaner
  # environment may not; without it, no tab is ever matched and nothing is
  # closed, which is the right way for this to fail.
  local lsof_bin="lsof"
  command -v lsof >/dev/null 2>&1 || lsof_bin=/usr/sbin/lsof
  [[ -x "$lsof_bin" ]] || command -v "$lsof_bin" >/dev/null 2>&1 || return 1

  local pids
  pids=$(ps -t "$tty" -o pid= 2>/dev/null | tr -d ' ' | tr '\n' ',' | sed 's/,$//') \
    || true
  [[ -n "$pids" ]] || return 1

  # lsof exits non-zero over a process that ended between the two calls, with
  # the other answers still on stdout, so its status is deliberately ignored.
  { "$lsof_bin" -a -d cwd -Fn -p "$pids" 2>/dev/null || true; } \
    | awk -v d="$dir" '
        /^n/ { p = substr($0, 2); if (p == d || index(p, d "/") == 1) { hit = 1 } }
        END  { exit !hit }
      '
}

# Print the id of every iTerm2 session sitting in $1, or below it. This finds
# the tab `wt` opened for a worktree as well as any the user opened by hand.
# Silent when iTerm2 is not running - and it is asked whether it is running
# rather than told anything, so this never launches it.
iterm_sessions_in() {
  local dir="$1"
  local sessions
  sessions=$(osascript 2>/dev/null <<'APPLESCRIPT'
if application "iTerm2" is running then
  tell application "iTerm2"
    set out to ""
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          set out to out & (id of s) & " " & (tty of s) & linefeed
        end repeat
      end repeat
    end repeat
    return out
  end tell
end if
return ""
APPLESCRIPT
  ) || return 0

  local id tty
  while read -r id tty; do
    [[ -n "$id" && -n "$tty" ]] || continue
    if tty_is_in "$tty" "$dir"; then
      echo "$id"
    fi
  done <<< "$sessions"
}

# Close one iTerm2 session by id. Each call rescans rather than closing a list
# of references collected earlier, because closing a session renumbers the
# ones after it and a stale reference would take the wrong tab with it.
close_iterm_session() {
  local session_id="$1"
  osascript <<APPLESCRIPT >/dev/null 2>&1 || true
if application "iTerm2" is running then
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (id of s) is "$(applescript_escape "$session_id")" then
            close s
            return
          end if
        end repeat
      end repeat
    end repeat
  end tell
end if
APPLESCRIPT
}

# The command a freshly opened tab should run ("" means: just cd there).
claude_cmd() {
  if [[ "${WT_NO_CLAUDE:-0}" == "1" ]]; then
    echo ""
    return
  fi
  local cmd="claude"
  if [[ -n "$WT_CLAUDE_ARGS" ]]; then
    cmd="$cmd $WT_CLAUDE_ARGS"
  fi
  local settings
  if settings=$(tab_title_settings); then
    cmd="$cmd --settings $(printf '%q' "$settings")"
  fi
  echo "$cmd"
}

# Hooks that put a worktree's pull request number in its iTerm2 tab title,
# written to a settings file passed to `claude --settings` so nothing has to be
# added to the user's own Claude Code configuration. They call back into this
# script (see cmd_tab_title). Prints the file's path, or fails when titles are
# turned off or the file cannot be written.
tab_title_settings() {
  [[ "${WT_NO_TAB_TITLE:-0}" != "1" ]] || return 1

  # The hook runs from wherever claude was started, so a bare "wt" is pinned
  # down to the copy on the PATH now.
  local self="$WT_SELF"
  if [[ "$self" != /* ]]; then
    self=$(command -v "$self" 2>/dev/null) || return 1
  fi

  local dir="${XDG_STATE_HOME:-$HOME/.local/state}/wt"
  local file="$dir/claude-tab-title.json"
  mkdir -p "$dir" 2>/dev/null || return 1

  local hook; hook=$(json_escape "$(printf '%q' "$self") __tab-title")
  cat > "$file" 2>/dev/null <<EOF || return 1
{
  "hooks": {
    "PostToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "$hook created" }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "$hook idle" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "$hook idle" }] }
    ]
  }
}
EOF
  echo "$file"
}

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

# The terminal the hook's claude is drawing on. Hooks get a pipe for stdin and
# stdout, but they are still in claude's process tree, and the first ancestor
# with a controlling terminal is the tab.
hook_tty() {
  local pid=$$ tty
  while [[ -n "$pid" && "$pid" != 0 && "$pid" != 1 ]]; do
    tty=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ') || return 1
    if [[ -n "$tty" && "$tty" != "??" ]]; then
      echo "/dev/$tty"
      return 0
    fi
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ') || return 1
  done
  return 1
}

# `wt __tab-title created|idle`, run by the hooks from tab_title_settings with
# the hook's JSON on stdin.
#
# Claude Code sets the tab title itself (its topic, and a spinner while it
# works), and iTerm2 has no way to pin a title against that - the last escape
# sequence wins. So the PR title is re-asserted whenever claude goes idle, a
# moment after it has drawn its own: it shows between turns and gives way to
# the spinner during one.
#
# The number is kept in the worktree's own git directory, which goes when the
# worktree does. A `gh pr create` looks it up straight away; otherwise it is
# asked of GitHub at most every ten minutes, which also catches a PR opened
# from the web, or one that existed before the tab did. Everything slow runs
# detached, so claude never waits on the network for a title.
cmd_tab_title() {
  local event="${1:-idle}"
  local payload; payload=$(cat)

  local gitdir; gitdir=$(git rev-parse --absolute-git-dir 2>/dev/null) || return 0
  local tty; tty=$(hook_tty) || return 0
  [[ -w "$tty" ]] || return 0

  local cache="$gitdir/wt-pr" checked="$gitdir/wt-pr-checked"
  local pr=""
  if [[ -f "$cache" ]]; then
    pr=$(cat "$cache" 2>/dev/null || true)
  fi

  local lookup=0
  if [[ "$event" == "created" ]]; then
    [[ "$payload" == *"gh pr create"* ]] || return 0
    lookup=1
  elif [[ -z "$pr" && "${WT_NO_PR:-0}" != "1" ]] \
       && [[ -z "$(find "$checked" -mmin -10 2>/dev/null)" ]]; then
    lookup=1
  fi
  if (( lookup )) && ! command -v gh >/dev/null 2>&1; then
    lookup=0
  fi
  # With nothing cached and nothing to look up, there is still one case worth
  # waiting for: a `gh pr create` at the very end of this turn, whose lookup
  # may not have finished by the time claude goes idle.
  local wait_for_cache=0
  if [[ -z "$pr" && "$lookup" == 0 ]]; then
    [[ "$event" == "idle" && -n "$(find "$checked" -mmin -1 2>/dev/null)" ]] || return 0
    wait_for_cache=1
  fi

  (
    if (( lookup )); then
      touch "$checked" 2>/dev/null || true
      found=$(gh pr view --json number -q .number 2>/dev/null || true)
      if [[ "$found" =~ ^[0-9]+$ ]]; then
        pr="$found"
        printf '%s\n' "$pr" > "$cache" 2>/dev/null || true
      fi
    fi
    [[ "$event" == "idle" ]] || exit 0
    sleep 1
    tries=0
    while (( wait_for_cache && tries < 8 )) && [[ -z "$pr" ]]; do
      pr=$(cat "$cache" 2>/dev/null || true)
      [[ -n "$pr" ]] || sleep 1
      tries=$((tries + 1))
    done
    if [[ -n "$pr" ]]; then
      printf '\033]1;PR #%s\007' "$pr" > "$tty" 2>/dev/null || true
    fi
  ) </dev/null >/dev/null 2>&1 &
  return 0
}

# Print the URL of the issue a branch is named after ("1234-some-title" ->
# issue 1234), or nothing when the branch has no leading issue number.
issue_url_for_branch() {
  local root="$1" branch="$2"
  local num="${branch%%-*}"
  [[ "$num" =~ ^[0-9]+$ ]] || return 0
  command -v gh >/dev/null 2>&1 || return 0
  (cd "$root" && gh issue view "$num" --json url -q .url 2>/dev/null) || true
}

# Open a worktree in a new tab. Pass "1" as $4 for a worktree created just
# now: its claude gets the issue link typed into the prompt box, left unsent.
# Reopening an existing worktree never prefills, because that session has its
# own history and the link would only be in the way.
open_worktree() {
  local root="$1" wt_path="$2" branch="$3" seed="${4:-0}"

  local url prompt=""
  if [[ "$seed" == "1" && "${WT_NO_CLAUDE:-0}" != "1" && -n "$WT_PROMPT_TEMPLATE" ]]; then
    url=$(issue_url_for_branch "$root" "$branch")
    if [[ -n "$url" ]]; then
      prompt="${WT_PROMPT_TEMPLATE//\{url\}/$url}"
      echo "Prefilling claude's prompt (press enter to send it):"
      echo "  $prompt"
    fi
  fi

  open_iterm_tab "$wt_path" "$(claude_cmd)" "$prompt"
}

require_gh() {
  command -v gh >/dev/null 2>&1 || die "gh CLI not found. Install with 'brew install gh' and run 'gh auth login', or pass a branch name instead."
}

# Let the user pick one of the repo's open GitHub issues, and print the
# resulting "<number>-<slug>" branch name. The menu goes to stderr so stdout
# carries only the chosen name; prints nothing at all if the user cancels.
pick_issue_branch() {
  local root="$1" only_mine="$2"
  require_gh

  local -a gh_args=(issue list --state open --limit "${WT_ISSUE_LIMIT:-30}")
  if [[ "$only_mine" == "1" ]]; then
    gh_args[${#gh_args[@]}]="--assignee"
    gh_args[${#gh_args[@]}]="@me"
  fi

  echo "Fetching open issues..." >&2
  local raw
  raw=$(cd "$root" && gh "${gh_args[@]}" --json number,title \
          --jq '.[] | [.number, .title] | @tsv' 2>&1) \
    || die "could not list issues via gh: $raw"

  local -a numbers=() titles=()
  local num title
  while IFS=$'\t' read -r num title; do
    [[ -n "$num" ]] || continue
    numbers[${#numbers[@]}]="$num"
    titles[${#titles[@]}]="$title"
  done <<< "$raw"

  if (( ${#numbers[@]} == 0 )); then
    if [[ "$only_mine" == "1" ]]; then
      die "no open issues assigned to you (drop --mine to see all)"
    fi
    die "no open issues found for this repo"
  fi

  # Branch names of worktrees that already exist, so the menu can flag issues
  # that are already checked out somewhere.
  local existing
  existing=$(list_worktrees "$root" 0 | cut -f2)

  local label
  label=$(cd "$root" && gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null) \
    || label=$(repo_name)

  # Menu lines are "<number><TAB><display>"; the number stays hidden from the
  # display but is what both fzf's preview and the parsing below read.
  local i shown marks menu=""
  for i in "${!numbers[@]}"; do
    marks=""
    if echo "$existing" | grep -q "^${numbers[$i]}-"; then
      marks="  [worktree exists]"
    fi
    shown="${titles[$i]}"
    if (( ${#shown} > 64 )); then
      shown="${shown:0:61}..."
    fi
    menu="$menu$(printf '%s\t#%-6s  %-64s%s' \
      "${numbers[$i]}" "${numbers[$i]}" "$shown" "$marks")"$'\n'
  done

  local reply
  if have_fzf; then
    local sel
    sel=$(printf '%s' "$menu" | fzf \
      --delimiter=$'\t' --with-nth=2.. \
      --height=90% --border --reverse --no-multi \
      --prompt='issue > ' \
      --header="$label   (type to filter, enter to pick, esc to cancel)" \
      --preview="cd $(printf '%q' "$root") && gh issue view {1}" \
      --preview-window='right:48%:wrap') || return 0
    [[ -n "$sel" ]] || return 0
    reply=$(printf '%s' "$sel" | cut -f1)
  else
    echo >&2
    echo "Open issues in $label:" >&2
    printf '%s' "$menu" | cut -f2- | sed 's/^/  /' >&2
    echo >&2
    read -r -p "Which issue? (issue number, blank to cancel): " reply
    if [[ -z "${reply//[[:space:]]/}" ]]; then
      return 0
    fi
  fi

  reply="${reply#\#}"
  [[ "$reply" =~ ^[0-9]+$ ]] || die "not an issue number: '$reply'"

  # Reuse the title already fetched for a listed issue; for anything else, look
  # it up, so an issue past the end of the list is still usable.
  local picked=""
  for i in "${!numbers[@]}"; do
    if [[ "${numbers[$i]}" == "$reply" ]]; then
      picked="${titles[$i]}"
      break
    fi
  done
  if [[ -z "$picked" ]]; then
    echo "#$reply is not in the list above, looking it up..." >&2
    picked=$(cd "$root" && gh issue view "$reply" --json title -q .title 2>/dev/null) \
      || die "no such issue: #$reply"
  fi

  echo "Issue #$reply: $picked" >&2
  local slug; slug=$(slugify "$picked")
  if [[ -n "$slug" ]]; then
    echo "$reply-$slug"
  else
    echo "$reply"
  fi
}

# Fetch the base branch and fast-forward the local copy of it to match.
#
# The worktree itself is always created from origin/<base>, so this is not for
# the new branch - it is for the checkout the user came from. Without it that
# tree's `main` drifts further behind on every `wt new`, and the next build,
# test run or diff there is against a stale base.
#
# Never anything but a fast-forward: local commits on the base branch, or a
# working tree that would be clobbered, leave it exactly as it was with a note.
sync_base_branch() {
  local root="$1" base="$2"

  echo "Fetching latest '$base'..."
  git -C "$root" fetch origin "$base" --quiet 2>/dev/null \
    || { echo "  (fetch failed - using what is already here)"; return 0; }

  [[ "${WT_NO_PULL:-0}" != "1" ]] || return 0
  git -C "$root" show-ref --verify --quiet "refs/remotes/origin/$base" || return 0
  git -C "$root" show-ref --verify --quiet "refs/heads/$base" || return 0

  local local_sha remote_sha
  local_sha=$(git -C "$root" rev-parse "refs/heads/$base")
  remote_sha=$(git -C "$root" rev-parse "refs/remotes/origin/$base")
  [[ "$local_sha" != "$remote_sha" ]] || return 0

  if ! git -C "$root" merge-base --is-ancestor "$local_sha" "$remote_sha"; then
    echo "  Local '$base' has commits origin/$base does not; leaving it alone."
    return 0
  fi

  local behind
  behind=$(git -C "$root" rev-list --count "$local_sha..$remote_sha" 2>/dev/null) \
    || behind=""

  # Not checked out anywhere, so there is no working tree to disturb and the
  # ref can simply be moved. The old value is passed too, so a concurrent git
  # that moved it in the meantime makes this fail rather than overwrite.
  local held; held=$(find_worktree_path "$root" "$base")
  if [[ -z "$held" ]]; then
    if git -C "$root" update-ref -m "wt: fast-forward to origin/$base" \
         "refs/heads/$base" "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "  Fast-forwarded '$base' by ${behind:-some} commit(s)."
    fi
    return 0
  fi

  # Checked out somewhere: this has to go through a merge so that the index and
  # the files on disk move with the ref. --ff-only makes git refuse rather than
  # merge or clobber, which is the whole contract here.
  if git -C "$held" merge --ff-only --quiet "origin/$base" 2>/dev/null; then
    echo "  Fast-forwarded '$base' by ${behind:-some} commit(s) in $(short_path "$held")."
  else
    echo "  Could not fast-forward '$base' in $(short_path "$held"); leaving it alone."
  fi
}

cmd_new() {
  local arg="" only_mine=0 a
  for a in "$@"; do
    case "$a" in
      --mine) only_mine=1 ;;
      -*) die "unknown option '$a' (see 'wt help')" ;;
      *)
        [[ -z "$arg" ]] || die "usage: wt new [--mine] [issue-number|branch-name]"
        arg="$a"
        ;;
    esac
  done

  local root repo base branch title
  root=$(repo_root)
  repo=$(repo_name)
  base="${WT_BASE_BRANCH:-$(default_branch "$root")}"

  if [[ -z "$arg" ]]; then
    branch=$(pick_issue_branch "$root" "$only_mine")
    if [[ -z "$branch" ]]; then
      echo "Cancelled."
      return
    fi
  elif [[ "$arg" =~ ^[0-9]+$ ]]; then
    require_gh
    title=$(cd "$root" && gh issue view "$arg" --json title -q .title) || die "could not fetch issue #$arg via gh"
    branch="${arg}-$(slugify "$title")"
    echo "Issue #$arg: $title"
  else
    branch=$(slugify "$arg")
  fi

  local wt_path="$WT_ROOT/$repo/$branch"

  # Already checked out somewhere? Then "new" means "take me back to it".
  local live; live=$(find_worktree_path "$root" "$branch")
  if [[ -n "$live" ]]; then
    if [[ -d "$live" ]]; then
      echo "Worktree for '$branch' already exists, opening it."
      open_worktree "$root" "$live" "$branch"
      return
    fi
    # Registered but the directory is gone. `worktree add` does not prune
    # stale entries itself, so without this it dies with "'$branch' is
    # already used by worktree at <a path that no longer exists>".
    echo "Clearing stale worktree registration at $live"
    git -C "$root" worktree prune
  fi

  # Same issue, older title: the branch name derived just now carries the
  # current slug, so the exact lookup above misses a worktree created before
  # the issue was renamed. The picker already calls that issue checked out, so
  # honour it rather than creating a second worktree for the same issue.
  local num="${branch%%-*}"
  if [[ "$num" =~ ^[0-9]+$ ]]; then
    local found found_path found_branch
    found=$(find_worktree_for_issue "$root" "$num")
    if [[ -n "$found" ]]; then
      IFS=$'\t' read -r found_path found_branch <<< "$found"
      if [[ -d "$found_path" ]]; then
        echo "Issue #$num is already checked out as '$found_branch', opening it."
        open_worktree "$root" "$found_path" "$found_branch"
        return
      fi
    fi
  fi

  # A directory in the way that git knows nothing about needs a human.
  [[ -e "$wt_path" ]] \
    && die "path already exists and is not a worktree for '$branch': $wt_path"

  mkdir -p "$(dirname "$wt_path")"

  sync_base_branch "$root" "$base"

  if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
    # Branch left behind by an earlier `wt rm` that kept it: check it out
    # rather than failing on `-b`, which refuses an existing branch.
    echo "Creating worktree at $wt_path (existing branch: $branch)"
    git -C "$root" worktree add "$wt_path" "$branch"
  else
    echo "Creating worktree at $wt_path (branch: $branch, base: $base)"
    if git -C "$root" show-ref --verify --quiet "refs/remotes/origin/$base"; then
      git -C "$root" worktree add -b "$branch" "$wt_path" "origin/$base"
    else
      git -C "$root" worktree add -b "$branch" "$wt_path" "$base"
    fi
  fi

  open_worktree "$root" "$wt_path" "$branch" 1
}

# Pick one worktree (the main working tree included) and open it in a new tab.
pick_worktree_and_open() {
  local root="$1"

  local -a paths=() branches=()
  local path branch
  while IFS=$'\t' read -r path branch; do
    [[ -n "$path" ]] || continue
    paths[${#paths[@]}]="$path"
    branches[${#branches[@]}]="$branch"
  done < <(list_worktrees "$root" 1)

  (( ${#paths[@]} > 0 )) || die "no worktrees found for this repo"

  pr_index_load "$root" ${branches[@]+"${branches[@]}"}
  menu_init "$root" ${branches[@]+"${branches[@]}"}

  local here; here=$(git rev-parse --show-toplevel 2>/dev/null || true)
  local i menu=""
  for i in "${!paths[@]}"; do
    menu="$menu$(worktree_menu_line "$i" "${paths[$i]}" "${branches[$i]}" "$here")"$'\n'
  done

  local idx
  if have_fzf; then
    local header
    header="Worktrees for $(repo_name)   (type \"merged\" for landed work only)"
    idx=$(printf '%s' "$menu" | fzf_pick_worktrees \
      "$header"$'\n'"enter to open in a new tab, esc to cancel" \
      --no-multi 'open > ') || { echo "Cancelled."; return; }
    if [[ -z "$idx" ]]; then
      echo "Cancelled."
      return
    fi
  else
    echo "Worktrees for $(repo_name):"
    printf '%s' "$menu" | awk -F'\t' '{ printf "  %2d) %s %s %s\n", NR, $3, $4, $5 }'
    echo
    local reply
    read -r -p "Open which? (row number, blank to cancel): " reply || reply=""
    if [[ -z "${reply//[[:space:]]/}" ]]; then
      echo "Cancelled."
      return
    fi
    [[ "$reply" =~ ^[0-9]+$ ]] || die "invalid selection '$reply'"
    (( reply >= 1 && reply <= ${#paths[@]} )) || die "selection out of range: $reply"
    idx=$((reply - 1))
  fi

  local target="${paths[$idx]}"
  [[ -d "$target" ]] \
    || die "cannot open '${branches[$idx]}': $target no longer exists (stale worktree; clear it with 'wt rm')"

  echo "Opening ${branches[$idx]} at $(short_path "$target")"
  open_worktree "$root" "$target" "${branches[$idx]}"
}

cmd_list() {
  local plain=0 a
  for a in "$@"; do
    case "$a" in
      --plain|-p) plain=1 ;;
      *) die "unknown option '$a' (see 'wt help')" ;;
    esac
  done

  local root; root=$(repo_root)
  if (( plain )); then
    git -C "$root" worktree list
    return
  fi
  pick_worktree_and_open "$root"
}

# Print "path<TAB>branch" for a worktree whose branch is named after issue $2
# ("1234" or "1234-anything"), or nothing. The issue picker flags an issue as
# already checked out by this same leading-number rule, so the two agree even
# once the issue title, and with it the slug, has been edited.
find_worktree_for_issue() {
  local root="$1" num="$2"
  list_worktrees "$root" 0 | awk -F'\t' -v n="$num" '
    $2 == n || index($2, n "-") == 1 { print; exit }
  '
}

# Look up the filesystem path of the worktree for a given branch name.
find_worktree_path() {
  local root="$1" branch="$2"
  git -C "$root" worktree list --porcelain | awk -v b="refs/heads/$branch" '
    /^worktree /{p=substr($0,10)}
    /^branch /{if ($2==b) print p}
  '
}

cmd_open() {
  local branch="${1:-}"
  local root; root=$(repo_root)
  if [[ -z "$branch" ]]; then
    pick_worktree_and_open "$root"
    return
  fi
  local wt_path; wt_path=$(find_worktree_path "$root" "$branch")
  [[ -n "$wt_path" ]] || die "no worktree found for branch '$branch' (try 'wt list')"

  open_worktree "$root" "$wt_path" "$branch"
}

# Emit "path<TAB>branch" for the repo's worktrees. Pass "1" as $2 to include
# the main working tree, which git always lists first (hence the block
# counter) and which `wt rm` must never offer.
list_worktrees() {
  local root="$1" include_main="${2:-0}"
  git -C "$root" worktree list --porcelain | awk -v inc="$include_main" '
    /^worktree /{ n++; p = substr($0, 10); b = ""; next }
    /^branch /  { b = substr($0, 8); sub(/^refs\/heads\//, "", b); next }
    /^detached/ { b = "(detached)"; next }
    /^$/        { if ((inc == 1 || n > 1) && p != "") print p "\t" b; p = ""; next }
    END         { if ((inc == 1 || n > 1) && p != "") print p "\t" b }
  '
}

# Colour, decided once per run: the menus are read by a human at a terminal,
# and anywhere else - a pipe, a NO_COLOR environment - the escapes would be
# noise. Set from the dispatcher, where stdout is still the terminal; inside
# the $(...) that builds a menu line it no longer is.
WT_COLOR=0
color_init() {
  if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    WT_COLOR=1
  else
    WT_COLOR=0
  fi
}

paint() {
  local code="$1" text="$2"
  if (( WT_COLOR )); then
    printf '\033[%sm%s\033[0m' "$code" "$text"
  else
    printf '%s' "$text"
  fi
}

# Turns `gh pr list` JSON into "<branch><TAB><label>" lines. Open pull
# requests are sorted first so that a branch reusing the name of an older,
# closed PR still shows the live one. Review and check state are only worth
# reporting while a PR is open; once it is merged or closed they are noise.
PR_LABEL_JQ='
sort_by(.state != "OPEN")
| .[]
| [ (.statusCheckRollup // [])[]
    | ((.conclusion // "") + " " + (.status // "") + " " + (.state // "")) ] as $checks
| (if .state != "OPEN" then (.state | ascii_downcase)
   elif .isDraft then "draft"
   else "open" end) as $st
| (if .state != "OPEN" then ""
   elif .reviewDecision == "APPROVED" then ", approved"
   elif .reviewDecision == "CHANGES_REQUESTED" then ", changes requested"
   else "" end) as $review
| (if .state != "OPEN" or ($checks | length) == 0 then ""
   elif any($checks[]; test("FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED")) then ", checks failing"
   elif any($checks[]; test("PENDING|QUEUED|IN_PROGRESS|WAITING|REQUESTED")) then ", checks pending"
   else ", checks passing" end) as $checkstate
| [ .headRefName, "#\(.number) \($st)\($review)\($checkstate)" ]
| @tsv
'

# Pull request state, cached in WT_PR_INDEX as "<branch><TAB><label>" lines.
# Asked for per branch rather than by listing the repo's PRs, because a busy
# repo's most recent hundred PRs are mostly other people's and would miss the
# one belonging to a worktree branched a fortnight ago. The lookups run in
# parallel since they are all network latency and nothing else.
#
# Any failure - no gh, not logged in, no GitHub remote - leaves the index
# empty on purpose: PR annotations are a nicety and must never break a menu.
WT_PR_INDEX=""
pr_index_load() {
  local root="$1"; shift
  WT_PR_INDEX=""
  if [[ "${WT_NO_PR:-0}" == "1" ]] || (( $# == 0 )); then
    return 0
  fi
  command -v gh >/dev/null 2>&1 || return 0

  local tmp
  tmp=$(mktemp -d) || return 0

  echo "Checking pull requests..." >&2
  local branch i=0
  for branch in "$@"; do
    if [[ -z "$branch" || "$branch" == "(detached)" ]]; then
      continue
    fi
    pr_lookup_branch "$root" "$branch" > "$tmp/$i" &
    i=$((i + 1))
    # Bash 3.2 has no `wait -n`, so concurrency is capped in batches instead,
    # to stay clear of GitHub's limits on a repo with many worktrees.
    if (( i % 8 == 0 )); then
      wait || true
    fi
  done
  wait || true

  WT_PR_INDEX=$(cat "$tmp"/* 2>/dev/null || true)
  rm -rf "$tmp"
}

# Print "<branch><TAB><label>" for one branch's pull request, or nothing.
pr_lookup_branch() {
  local root="$1" branch="$2"
  local fields=number,headRefName,state,isDraft,reviewDecision,statusCheckRollup
  (cd "$root" && gh pr list --head "$branch" --state all --limit 10 \
     --json "$fields" --jq "$PR_LABEL_JQ" 2>/dev/null) | head -1 || true
}

# The label for a branch's pull request ("#12 open, checks failing"), or
# nothing when it has none or the index could not be built.
pr_label_for_branch() {
  local branch="$1"
  if [[ -z "$WT_PR_INDEX" || -z "$branch" || "$branch" == "(detached)" ]]; then
    return 0
  fi
  printf '%s\n' "$WT_PR_INDEX" | awk -F'\t' -v b="$branch" '$1 == b { print $2; exit }'
}

# The bracketed, coloured mark for a PR label, or nothing for a branch with no
# pull request. Merged is the one state that means removing the worktree loses
# nothing, so it gets the tick and the green: a dozen worktrees can be scanned
# for what is safe to clear away without reading any of them.
pr_mark() {
  local pr="$1"
  case "$pr" in
    "")      return 0 ;;
    *merged) paint 32 "[✓ PR $pr]" ;;
    *closed) paint 90 "[PR $pr]" ;;
    *)       paint 33 "[PR $pr]" ;;
  esac
}

# The repo's main working tree, which git always lists first. Taken from git
# rather than from the current directory, so that running inside a worktree
# still identifies the folder its siblings live in.
main_worktree() {
  git -C "$1" worktree list --porcelain \
    | awk '/^worktree /{ print substr($0, 10); exit }'
}

# Per-run layout, worked out once from the worktrees about to be listed and
# read back by worktree_menu_line. The branch column is as wide as the longest
# branch, so the marks form a column you can run your eye down; the clamp
# keeps one absurd branch name from pushing every mark off the screen.
WT_BRANCH_WIDTH=42
WT_WORKTREE_HOME=""
menu_init() {
  local root="$1"; shift
  WT_WORKTREE_HOME="$WT_ROOT/$(basename "$(main_worktree "$root")")"

  local b w=20
  for b in "$@"; do
    if (( ${#b} > w )); then
      w=${#b}
    fi
  done
  if (( w > 56 )); then
    w=56
  fi
  WT_BRANCH_WIDTH="$w"
}

# Where the worktree sits - but only when that is worth a column. `wt` puts
# everything it creates at $WT_ROOT/<repo>/<branch>, so a path per row would
# be the same string over and over, crowding out the branch names and the
# marks and getting truncated for its trouble. Anything that is not at its
# expected address still says where it is: the main working tree, a directory
# whose name no longer matches its branch, a worktree from somewhere else.
worktree_location() {
  local wt_path="$1" branch="$2"
  if [[ -z "$WT_WORKTREE_HOME" || "$wt_path" == "$WT_WORKTREE_HOME/$branch" ]]; then
    return 0
  fi
  if [[ "$wt_path" == "$WT_WORKTREE_HOME/"* ]]; then
    # Only the leaf, and only a hint's worth of it: the point is that the
    # directory is not named after the branch, not what it is called. The
    # preview pane carries the path in full.
    local dir="${wt_path#"$WT_WORKTREE_HOME"/}"
    if (( ${#dir} > 30 )); then
      dir="${dir:0:27}..."
    fi
    paint 90 "in $dir"
    return 0
  fi
  paint 90 "$(short_path "$wt_path")"
}

# Format one worktree as a menu line:
# "<index><TAB><path><TAB><branch><TAB><marks><TAB><location>".
# fzf displays fields 3.. and hands back the index. Matching is limited to the
# branch name and the marks, so a long shared path prefix cannot match
# everything, while typing "merged" narrows the list to what is safe to remove.
worktree_menu_line() {
  local idx="$1" wt_path="$2" branch="$3" here="$4" current_label="${5:-current}"
  local marks="" mark
  mark=$(pr_mark "$(pr_label_for_branch "$branch")")
  if [[ -n "$mark" ]]; then
    marks="$marks $mark"
  fi
  if [[ -d "$wt_path" ]]; then
    if worktree_is_dirty "$wt_path"; then
      marks="$marks $(paint 31 "[uncommitted changes]")"
    fi
  else
    marks="$marks $(paint 90 "[missing, stale entry]")"
  fi
  if [[ "$wt_path" == "$here" ]]; then
    marks="$marks $(paint 36 "[$current_label]")"
  fi
  printf '%s\t%s\t%-*s\t%s\t%s' \
    "$idx" "$wt_path" "$WT_BRANCH_WIDTH" "$branch" "${marks# }" \
    "$(worktree_location "$wt_path" "$branch")"
}

# What the fzf preview pane shows for the worktree at $1. A subcommand rather
# than a quoted one-liner inside the fzf call, so that it can be read, and
# checked by shellcheck, like the rest of the script.
#
# Colour is forced on here even though stdout is a pipe: it is a pipe straight
# into fzf, which renders it. NO_COLOR still wins.
cmd_preview() {
  local wt_path="${1:-}"
  if [[ -z "$wt_path" || ! -d "$wt_path" ]]; then
    echo "(directory is missing - stale registration)"
    return
  fi

  local -a git_color=(-c color.ui=always)
  local bold=$'\033[1m' plain=$'\033[0m'
  if [[ -n "${NO_COLOR:-}" ]]; then
    git_color=(-c color.ui=never)
    bold=""
    plain=""
  fi

  printf '%s%s%s\n\n' "$bold" "$(short_path "$wt_path")" "$plain"
  git -C "$wt_path" "${git_color[@]}" status --short --branch
  echo
  git -C "$wt_path" "${git_color[@]}" log --oneline --decorate -8
  echo

  if [[ "${WT_NO_PR:-0}" == "1" ]] || ! command -v gh >/dev/null 2>&1; then
    return
  fi

  # Told to behave as though it were on a terminal, `gh` renders the
  # description as markdown - headings, bold, code, tables - and prints a
  # readable header instead of the raw source and a column of empty fields,
  # which is what it falls back to when its output is a pipe. The width is
  # the preview pane's own, so the wrapping matches the box it lands in.
  (
    cd "$wt_path" \
      && GH_FORCE_TTY="${FZF_PREVIEW_COLUMNS:-80}" gh pr view 2>/dev/null
  ) || echo "(no pull request for this branch)"
}

# Run fzf over worktree menu lines on stdin, printing the chosen index(es).
# $1 = header, $2 = --multi or --no-multi, $3 = prompt.
fzf_pick_worktrees() {
  # The pull request is fetched per highlighted row rather than up front, so
  # the round trip only happens for worktrees the user actually stops on.
  fzf --delimiter=$'\t' --with-nth=3.. --nth=1,2 --ansi \
    --height=90% --border --reverse "$2" \
    --prompt="$3" --header="$1" \
    --preview="$(printf '%q' "$WT_SELF") __preview {2}" \
    --preview-window='right:48%:wrap' \
  | cut -f1
}

# Abbreviate $HOME to ~ so long worktree paths stay readable in menus.
short_path() {
  local p="$1"
  if [[ "$p" == "$HOME"/* ]]; then
    echo "~${p#"$HOME"}"
  else
    echo "$p"
  fi
}

worktree_is_dirty() {
  [[ -n "$(git -C "$1" status --porcelain 2>/dev/null)" ]]
}

# True while $2 is still registered as a worktree of the repo at $1. Matched by
# path, so it also covers detached worktrees that have no branch name.
worktree_is_registered() {
  local root="$1" wt_path="$2"
  git -C "$root" worktree list --porcelain \
    | awk -v p="worktree $wt_path" '$0 == p { found = 1 } END { exit !found }'
}

# Remove one worktree, warning first if it holds uncommitted work, then offer
# to delete its branch.
remove_one_worktree() {
  local wt_path="$1" branch="$2"
  local root; root=$(repo_root)
  local here; here=$(git rev-parse --show-toplevel 2>/dev/null || true)
  local yn

  if [[ "$wt_path" == "$here" ]]; then
    echo "Skipping '$branch': that is the worktree you are standing in." >&2
    return
  fi

  # Collected before the directory goes, while iTerm2 can still say which of
  # its tabs are sitting in it.
  local -a tabs=()
  local session_id
  if [[ "${WT_KEEP_TABS:-0}" != "1" ]]; then
    while read -r session_id; do
      [[ -n "$session_id" ]] || continue
      tabs[${#tabs[@]}]="$session_id"
    done < <(iterm_sessions_in "$wt_path")
  fi

  # A worktree whose directory is already gone is just a stale registration.
  # There is no work left to lose, so deregister it without prompting.
  if [[ -d "$wt_path" ]]; then
    if worktree_is_dirty "$wt_path"; then
      read -r -p "'$branch' has uncommitted changes. Discard them? [y/N] " yn || yn="n"
      if [[ ! "$yn" =~ ^[Yy]$ ]]; then
        echo "Skipping '$branch'."
        return
      fi
    fi
  else
    echo "'$branch': directory already gone, deregistering stale worktree."
  fi

  local out rc=0
  out=$(git -C "$root" worktree remove "$wt_path" --force 2>&1) || rc=$?
  if (( rc == 0 )); then
    echo "Removed worktree at $wt_path"
  elif [[ ! -d "$wt_path" ]]; then
    # Older git refuses to remove a worktree whose directory has vanished;
    # prune clears the stale registration instead.
    git -C "$root" worktree prune
    if worktree_is_registered "$root" "$wt_path"; then
      echo "$out" >&2
      die "could not deregister stale worktree at $wt_path"
    fi
    echo "Deregistered stale worktree $wt_path"
  else
    echo "$out" >&2
    die "could not remove worktree at $wt_path"
  fi

  # The directory is gone, so a tab left open in it is stranded: every command
  # it runs fails on a working directory that no longer exists, and a `claude`
  # in it has lost the tree it was working on. Closed after the removal
  # succeeds, never before, so a refusal leaves the session alone.
  if (( ${#tabs[@]} > 0 )); then
    for session_id in "${tabs[@]}"; do
      close_iterm_session "$session_id"
    done
    if (( ${#tabs[@]} == 1 )); then
      echo "Closed the iTerm2 tab that was in it"
    else
      echo "Closed ${#tabs[@]} iTerm2 tabs that were in it"
    fi
  fi

  if [[ "$branch" != "(detached)" ]] \
     && git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
    read -r -p "Delete local branch '$branch' too? [y/N] " yn || yn="n"
    if [[ "$yn" =~ ^[Yy]$ ]]; then
      git -C "$root" branch -D "$branch"
    fi
  fi
}

cmd_rm() {
  local root; root=$(repo_root)

  # Explicit branch name: remove it directly, no menu.
  if [[ -n "${1:-}" ]]; then
    local wt_path; wt_path=$(find_worktree_path "$root" "$1")
    [[ -n "$wt_path" ]] || die "no worktree found for branch '$1' (try 'wt list')"
    pr_index_load "$root" "$1"
    local pr; pr=$(pr_label_for_branch "$1")
    if [[ -n "$pr" ]]; then
      echo "Pull request: $(pr_mark "$pr")"
    fi
    remove_one_worktree "$wt_path" "$1"
    return
  fi

  # No argument: offer the picker, and come back to it after each removal so a
  # handful of worktrees can be cleared out one decision at a time. Only
  # cancelling the picker - or running out of worktrees - ends the session.
  if [[ -z "$(list_worktrees "$root" 0)" ]]; then
    die "no linked worktrees for this repo (the main working tree is not removable)"
  fi
  local first=1
  while rm_menu_round "$root" "$first"; do
    first=0
    if [[ -z "$(list_worktrees "$root" 0)" ]]; then
      echo
      echo "No linked worktrees left."
      return
    fi
    echo
  done
}

# One pass of the `wt rm` picker: pick, confirm, remove. Returns non-zero when
# the user cancels the picker, which is what ends the loop in cmd_rm; declining
# the confirmation only returns to the list. Pull requests are looked up on the
# first pass alone: removing worktrees only ever shrinks the set of branches,
# so the index already holds every one a later pass can show.
rm_menu_round() {
  local root="$1" first="$2"
  local -a paths=() branches=()
  local path branch
  while IFS=$'\t' read -r path branch; do
    [[ -n "$path" ]] || continue
    paths[${#paths[@]}]="$path"
    branches[${#branches[@]}]="$branch"
  done < <(list_worktrees "$root" 0)

  (( ${#paths[@]} > 0 )) || return 1

  if [[ "$first" == "1" ]]; then
    pr_index_load "$root" ${branches[@]+"${branches[@]}"}
  fi
  menu_init "$root" ${branches[@]+"${branches[@]}"}

  local here; here=$(git rev-parse --show-toplevel 2>/dev/null || true)

  # Menu lines are "<index><TAB><path><TAB><branch><TAB><detail>". fzf displays
  # fields 3.. and hands back the index; --nth=1 keeps typing matched against
  # the branch name only, so a long shared path prefix cannot match everything.
  local i menu=""
  for i in "${!paths[@]}"; do
    menu="$menu$(worktree_menu_line "$i" "${paths[$i]}" "${branches[$i]}" \
      "$here" "current, cannot remove")"$'\n'
  done

  local -a chosen=()
  local reply

  if have_fzf; then
    local sel
    local header
    header="Worktrees for $(repo_name)   (type \"merged\" for landed work only)"
    sel=$(printf '%s' "$menu" | fzf_pick_worktrees \
      "$header"$'\n'"tab to mark several, enter to confirm, esc to cancel" \
      --multi 'remove > ') || { echo "Cancelled."; return 1; }
    if [[ -z "$sel" ]]; then
      echo "Cancelled."
      return 1
    fi
    while read -r i; do
      [[ -n "$i" ]] || continue
      chosen[${#chosen[@]}]="$i"
    done <<< "$sel"
  else
    echo "Worktrees for $(repo_name):"
    printf '%s' "$menu" | awk -F'\t' '{ printf "  %2d) %s %s %s\n", NR, $3, $4, $5 }'
    echo
    read -r -p "Remove which? (e.g. '1 3', 'all', blank to cancel): " reply
    if [[ -z "${reply//[[:space:]]/}" ]]; then
      echo "Cancelled."
      return 1
    fi
    if [[ "$reply" == "all" ]]; then
      chosen=("${!paths[@]}")
    else
      local -a toks=()
      local tok
      read -ra toks <<< "${reply//,/ }"
      for tok in ${toks[@]+"${toks[@]}"}; do
        [[ "$tok" =~ ^[0-9]+$ ]] || die "invalid selection '$tok'"
        (( tok >= 1 && tok <= ${#paths[@]} )) || die "selection out of range: $tok"
        chosen[${#chosen[@]}]="$((tok - 1))"
      done
    fi
  fi

  (( ${#chosen[@]} > 0 )) || { echo "Cancelled."; return 1; }

  echo
  echo "About to remove:"
  local mark
  for i in "${chosen[@]}"; do
    mark=$(pr_mark "$(pr_label_for_branch "${branches[$i]}")")
    if [[ -n "$mark" ]]; then
      mark="  $mark"
    fi
    printf '  - %s  (%s)%s\n' "${branches[$i]}" "${paths[$i]}" "$mark"
  done

  local yn
  read -r -p "Proceed? [y/N] " yn || yn="n"
  if [[ ! "$yn" =~ ^[Yy]$ ]]; then
    echo "Nothing removed."
    return 0
  fi

  for i in "${chosen[@]}"; do
    echo
    remove_one_worktree "${paths[$i]}" "${branches[$i]}"
  done
  return 0
}

usage() {
  cat <<'EOF'
wt - git worktree helper with GitHub issue integration and iTerm2 automation

Usage:
  wt new                  Pick an open GitHub issue from a list, then branch from it
  wt new --mine           Same, narrowed to issues assigned to you
  wt new <issue-number>   Create a worktree/branch named after GitHub issue #<n>
  wt new <branch-name>    Create a worktree/branch with an explicit name
  wt list                 Pick a worktree and reopen it in a new iTerm2 tab
  wt list --plain         Print plain "git worktree list" output
                          (in either picker, type "merged" to see only the
                          worktrees whose pull request has landed)
  wt open [branch]        Same as "wt list"; with a branch, opens it directly
  wt rm [branch]          Remove a worktree; with no argument, pick from a list

Env vars:
  WT_ROOT          Where worktrees are stored (default: ~/worktrees)
  WT_BASE_BRANCH   Base branch to branch from (default: repo's default branch)
  WT_NO_CLAUDE     Set to "1" to skip auto-running claude in the new tab
  WT_CLAUDE_ARGS   Args passed to claude (default: --permission-mode auto)
  WT_ISSUE_LIMIT   How many issues to show in the picker (default: 30)
  WT_PROMPT_TEMPLATE
                   Prompt typed (unsent) into claude in a NEW issue worktree;
                   "{url}" becomes the issue URL. Set empty to disable.
  WT_PREFILL_DELAY Seconds to wait before typing that prompt (default: 6)
  WT_NO_PULL       Set to "1" to fetch only, leaving the local base branch put
  WT_NO_PR         Set to "1" to skip pull request lookups in the menus
  NO_COLOR         Set to anything to turn off colour in the pickers
  WT_KEEP_TABS     Set to "1" to leave a removed worktree's iTerm2 tabs open
  WT_NO_TAB_TITLE  Set to "1" to keep "PR #<n>" out of the tab title
EOF
}

color_init

case "${1:-}" in
  new)  shift; cmd_new "$@" ;;
  list) shift; cmd_list "$@" ;;
  open) shift; cmd_open "$@" ;;
  rm)   shift; cmd_rm "$@" ;;
  __preview) shift; cmd_preview "$@" ;;
  __tab-title) shift; cmd_tab_title "$@" ;;
  -h|--help|help|"") usage ;;
  *) die "unknown command '$1' (see 'wt help')" ;;
esac
